{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mon Profil – Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/admin-profile.css') }}">
{% endblock %}

{% block admin_content %}

{# ─── FLASH MESSAGES ─── #}
{% for msg in app.flashes('success') %}
    <div class="ap-flash ap-flash--success">
        <i class="fas fa-check-circle me-2"></i>{{ msg }}
    </div>
{% endfor %}
{% for msg in app.flashes('error') %}
    <div class="ap-flash ap-flash--error">
        <i class="fas fa-exclamation-circle me-2"></i>{{ msg }}
    </div>
{% endfor %}

<div class="ap-header">
    <div>
        <h2 class="ap-title"><i class="fas fa-user-shield me-2"></i>Mon Profil</h2>
        <p class="ap-subtitle">Gérez vos informations personnelles</p>
    </div>
</div>

<div class="ap-layout">

    {# ─── COLONNE GAUCHE : CARTE AVATAR ─── #}
    <aside class="ap-sidebar">
        <div class="ap-avatar-card">
            <div class="ap-avatar-wrap" id="avatarWrap">
                <div class="ap-avatar-initials" id="avatarInitials">
                    {{ admin.nom|slice(0,1)|upper }}
                </div>
            </div>
            <h5 class="ap-avatar-name">{{ admin.nom }}</h5>
            <span class="ap-badge"><i class="fas fa-shield-alt me-1"></i>Administrateur</span>
            <p class="ap-avatar-email">{{ admin.email }}</p>
        </div>

        <div class="ap-info-card">
            <h6 class="ap-info-title"><i class="fas fa-info-circle me-2"></i>Informations compte</h6>
            <ul class="ap-info-list">
                <li>
                    <span class="ap-info-label"><i class="fas fa-envelope"></i> Email</span>
                    <span class="ap-info-value">{{ admin.email }}</span>
                </li>
                <li>
                    <span class="ap-info-label"><i class="fas fa-phone"></i> Téléphone</span>
                    <span class="ap-info-value">{{ admin.telephone ?? '—' }}</span>
                </li>
                <li>
                    <span class="ap-info-label"><i class="fas fa-calendar"></i> Inscrit le</span>
                    <span class="ap-info-value">
                        {{ admin.dateCreation ? admin.dateCreation|date('d/m/Y') : '—' }}
                    </span>
                </li>
            </ul>
        </div>
    </aside>

    {# ─── COLONNE DROITE : VUE + FORMULAIRE ─── #}
    <main class="ap-main">

        {# ── MODE LECTURE (par défaut) ── #}
        <div class="ap-view-panel" id="viewPanel">
            <div class="ap-panel-header" style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                <div><i class="fas fa-id-card me-2"></i>Mes informations</div>
                <button type="button" class="ap-btn ap-btn--edit" id="btnEditPanel" onclick="toggleEdit(true)" style="padding: 0.3rem 0.8rem; font-size: 0.85rem; margin: -0.3rem 0;">
                    <i class="fas fa-pen me-2"></i>Modifier le profil
                </button>
            </div>
            <div class="ap-view-grid">
                <div class="ap-view-field ap-view-field--full">
                    <span class="ap-view-label">Nom complet</span>
                    <span class="ap-view-val">{{ admin.nom }}</span>
                </div>
                <div class="ap-view-field ap-view-field--full">
                    <span class="ap-view-label">Email</span>
                    <span class="ap-view-val">{{ admin.email }}</span>
                </div>
                <div class="ap-view-field ap-view-field--full">
                    <span class="ap-view-label">Téléphone</span>
                    <span class="ap-view-val">{{ admin.telephone ?? '—' }}</span>
                </div>
                <div class="ap-view-field ap-view-field--full">
                    <span class="ap-view-label">Mot de passe</span>
                    <span class="ap-view-val ap-pw-dots">••••••••••</span>
                </div>
            </div>
        </div>

        {# ── MODE ÉDITION (caché par défaut) ── #}
        <div class="ap-edit-panel" id="editPanel" style="display:none;">
            <div class="ap-panel-header">
                <i class="fas fa-pen me-2"></i>Modifier mes informations
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'ap-form'}}) }}

            {# Identité #}
            <div class="ap-form-section">
                <h6 class="ap-form-section-title">Identité</h6>
                <div class="ap-form-group">
                    {{ form_label(form.nom, 'Nom complet', {'label_attr': {'class': 'ap-label'}}) }}
                    {{ form_widget(form.nom) }}
                    <div class="ap-error">{{ form_errors(form.nom) }}</div>
                </div>
            </div>

            {# Contact #}
            <div class="ap-form-section">
                <h6 class="ap-form-section-title">Contact</h6>
                <div class="ap-form-group">
                    {{ form_label(form.email, 'Adresse email', {'label_attr': {'class': 'ap-label'}}) }}
                    {{ form_widget(form.email) }}
                    <small class="ap-hint"><i class="fas fa-lock me-1"></i>L'email ne peut pas être modifié</small>
                    <div class="ap-error">{{ form_errors(form.email) }}</div>
                </div>
                <div class="ap-form-group">
                    {{ form_label(form.telephone, 'Téléphone', {'label_attr': {'class': 'ap-label'}}) }}
                    {{ form_widget(form.telephone) }}
                    <small class="ap-hint">8 chiffres exactement (ex : 12345678)</small>
                    <div class="ap-error">{{ form_errors(form.telephone) }}</div>
                </div>
            </div>

            {# Mot de passe #}
            <div class="ap-form-section">
                <h6 class="ap-form-section-title">Sécurité</h6>
                <div class="ap-pw-note">
                    <i class="fas fa-info-circle me-1"></i>Laissez vide pour conserver votre mot de passe actuel
                </div>
                <div class="ap-form-row">
                    <div class="ap-form-group">
                        {{ form_label(form.newPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'ap-label'}}) }}
                        {{ form_widget(form.newPassword.first) }}
                    </div>
                    <div class="ap-form-group">
                        {{ form_label(form.newPassword.second, 'Confirmer', {'label_attr': {'class': 'ap-label'}}) }}
                        {{ form_widget(form.newPassword.second) }}
                    </div>
                </div>
                <div class="ap-error">{{ form_errors(form.newPassword) }}</div>
            </div>

            {# Actions #}
            <div class="ap-form-actions">
                <button type="submit" class="ap-btn ap-btn--save">
                    <i class="fas fa-save me-2"></i>Enregistrer les modifications
                </button>
                <button type="button" class="ap-btn ap-btn--cancel" onclick="toggleEdit(false)">
                    <i class="fas fa-times me-1"></i>Annuler
                </button>
            </div>

            {{ form_end(form) }}
        </div>

    </main>
</div>

<script>
function toggleEdit(editing) {
    const viewPanel  = document.getElementById('viewPanel');
    const editPanel  = document.getElementById('editPanel');
    const btnEditPanel = document.getElementById('btnEditPanel');

    if (editing) {
        viewPanel.style.display = 'none';
        editPanel.style.display = 'block';
        if (btnEditPanel) btnEditPanel.style.display = 'none';
        editPanel.scrollIntoView({behavior: 'smooth', block: 'start'});
    } else {
        editPanel.style.display = 'none';
        viewPanel.style.display = 'block';
        if (btnEditPanel) btnEditPanel.style.display = 'block';
    }
}

{% if not form.vars.valid and form.vars.submitted %}
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('viewPanel').style.display = 'none';
        document.getElementById('editPanel').style.display = 'block';
        const btn = document.getElementById('btnEditPanel');
        if (btn) btn.style.display = 'none';
    });
{% endif %}
</script>

{% endblock %}

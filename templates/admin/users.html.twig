{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion Utilisateurs{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <h1 class="mb-4"><i class="fas fa-users"></i> Gestion des utilisateurs</h1>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0">Liste des utilisateurs</h5>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <input type="text" id="searchInput" class="form-control form-control-sm"
                       placeholder="🔍 Rechercher par nom ou email..." style="width:260px;">
                <a href="{{ path('admin_users_export_csv') }}" class="btn btn-sm btn-success">
                    <i class="fas fa-file-csv"></i> Exporter CSV
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="usersTable">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Rôle</th>
                            <th>État</th>
                            <th>Date création</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        {% for user in users %}
                        <tr
                            data-nom="{{ user.nom|lower }}"
                            data-email="{{ user.email|lower }}"
                        >
                            <td>{{ user.nom }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.telephone ?? 'N/A' }}</td>
                            <td>
                                {% if user.role == 'AGRICULTEUR' %}
                                    <span class="badge bg-success">👨‍🌾 Agriculteur</span>
                                {% elseif user.role == 'FOURNISSEUR' %}
                                    <span class="badge bg-primary">🚚 Fournisseur</span>
                                {% elseif user.role == 'ADMIN' %}
                                    <span class="badge bg-dark">🛡️ Admin</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ user.role }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.etatCompte == 'ACTIF' %}
                                    <span class="badge bg-success">✅ Actif</span>
                                {% else %}
                                    <span class="badge bg-danger">🚫 Bloqué</span>
                                {% endif %}
                            </td>
                            <td>{{ user.dateCreation ? user.dateCreation|date('d/m/Y') : 'N/A' }}</td>
                            <td>
                                <a href="{{ path('admin_user_toggle', {id: user.userId}) }}"
                                   class="btn btn-sm {% if user.etatCompte == 'ACTIF' %}btn-danger{% else %}btn-success{% endif %}"
                                   onclick="return confirm('Êtes-vous sûr ?')">
                                    {% if user.etatCompte == 'ACTIF' %}
                                        <i class="fas fa-lock"></i> Bloquer
                                    {% else %}
                                        <i class="fas fa-unlock"></i> Activer
                                    {% endif %}
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center">Aucun utilisateur trouvé</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div id="noResults" class="text-center text-muted py-3" style="display:none;">
                    Aucun résultat trouvé.
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    if (!searchInput) return;

    searchInput.addEventListener('input', function () {
        const search = this.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#usersTableBody tr');
        let visibleCount = 0;

        rows.forEach(function(row) {
            const nom        = row.getAttribute('data-nom') || '';
            const emailFull  = row.getAttribute('data-email') || '';
            const emailLocal = emailFull.split('@')[0]; // partie avant le @

            // ✅ startsWith : affiche uniquement si le nom OU l'email commence par la recherche
            if (search === '' || nom.startsWith(search) || emailLocal.startsWith(search)) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('noResults').style.display = visibleCount === 0 ? 'block' : 'none';
    });
});
</script>
{% endblock %}

{% extends 'fournisseur.html.twig' %}

{% block title %}Modifier une Commande{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .calendar-wrapper { position: relative; }
    .calendar-wrapper input { padding-right: 40px; }
    .calendar-icon-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #4a7c3a;
        font-size: 1.2rem;
        background: none;
        border: none;
        z-index: 10;
    }
</style>
{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow border-0" style="border-radius: 15px;">
                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(to right, #4a7c3a, #66bb6a); border-radius: 15px 15px 0 0;">
                        <h3>✏️ Modifier la Commande</h3>
                    </div>
                    <div class="card-body p-5">

                        {% for message in app.flashes('danger') %}
                            <div class="alert alert-danger alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}

                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.produit, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.produit, {'attr': {'class': 'form-select' ~ (form.produit.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.produit) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.quantiteCommandee, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.quantiteCommandee, {'attr': {'class': 'form-control' ~ (form.quantiteCommandee.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.quantiteCommandee) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.dateCommande, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="calendar-wrapper">
                                {{ form_widget(form.dateCommande, {
                                    'attr': {
                                        'class': 'form-control' ~ (form.dateCommande.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'Cliquez pour choisir une date...',
                                        'readonly': 'readonly',
                                        'style': 'cursor:pointer;'
                                    }
                                }) }}
                                <button type="button" class="calendar-icon-btn" id="calendarBtn">📅</button>
                            </div>
                            {{ form_errors(form.dateCommande) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-select' ~ (form.statut.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.statut) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Prix Total (TND)</label>
                            <input type="text" class="form-control" value="{{ commande.prixTotal }} TND" readonly
                                   style="background-color: #f8f9fa; cursor: not-allowed;">
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success flex-grow-1">
                                <i class="bi bi-check-circle"></i> Modifier
                            </button>
                            <a href="{{ path('app_commande_index') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const fp = flatpickr("#commande_dateCommande", {
            locale: "fr",
            dateFormat: "Y-m-d",
            minDate: today,
            allowInput: false,
        });

        document.getElementById("calendarBtn").addEventListener("click", function () {
            fp.open();
        });

        document.getElementById("commande_dateCommande").addEventListener("click", function () {
            fp.open();
        });
    });
</script>
{% endblock %}
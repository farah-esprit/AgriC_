{% extends 'agriculteur.html.twig' %}

{% block title %}Nouveau Sujet - Forum AgriConnect{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="forum-header">
    <div class="container text-center">
        <h1 class="forum-title">Lancer une discussion</h1>
        <p class="forum-subtitle">Partagez votre question ou votre expérience avec la communauté.</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-premium-card shadow-lg border-0">
                {{ form_start(form) }}
                    <div class="text-danger mb-3">{{ form_errors(form) }}</div>
                    <div class="row g-4">
                        <div class="col-12">
                            <label class="fw-bold fs-5 mb-2 text-dark">Titre de la discussion</label>
                            {{ form_widget(form.title, {'attr': {'class': 'form-control form-control-agri', 'placeholder': 'Ex: Comment optimiser l\'irrigation en période de sécheresse ?'}}) }}
                            <div class="text-danger small mt-1">{{ form_errors(form.title) }}</div>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="fw-bold mb-2 text-dark">Catégorie</label>
                            {{ form_widget(form.category, {'attr': {'class': 'form-select form-control-agri'}}) }}
                            <div class="text-danger small mt-1">{{ form_errors(form.category) }}</div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold mb-2 text-dark">Tags (optionnel)</label>
                            {{ form_widget(form.tags, {'attr': {'class': 'form-control form-control-agri', 'placeholder': 'Ex: irrigation, eau, maïs'}}) }}
                            <div class="text-danger small mt-1">{{ form_errors(form.tags) }}</div>
                        </div>

                        <div class="col-12">
                            <label class="fw-bold mb-2 text-dark">Votre message</label>
                            {{ form_widget(form.content, {'attr': {'class': 'form-control form-control-agri', 'rows': '8', 'placeholder': 'Décrivez votre situation ici...'}}) }}
                            <div class="text-danger small mt-1">{{ form_errors(form.content) }}</div>
                        </div>

                        <div class="col-12 pt-4 border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="{{ path('thread_index') }}" class="btn btn-link text-muted text-decoration-none fw-bold">
                                    <i class="bi bi-arrow-left me-1"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-agri px-5 py-3 fs-5">
                                    <i class="bi bi-check-circle me-2"></i> Publier mon sujet
                                </button>
                            </div>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>

            <div class="mt-4 p-4 text-center">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> 
                    Assurez-vous de choisir un titre clair pour recevoir des réponses plus pertinentes.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

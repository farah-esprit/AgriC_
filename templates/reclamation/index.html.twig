{% extends 'agriculteur.html.twig' %}

{% block title %}Liste des Réclamations{% endblock %}

{% block body %}
<div class="container mt-5 pt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #d32f2f; font-weight: bold;">⚠️ Gestion des Réclamations</h2>
        <a href="{{ path('app_reclamation_new') }}" class="btn btn-danger">
            <i class="bi bi-plus-circle"></i> Soumettre une réclamation
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            ✅ {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card shadow border-0" style="border-radius:15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="border-collapse: separate; border-spacing: 0; border-radius:15px; overflow: hidden;">
                    <thead class="text-white" style="background: linear-gradient(to right,#d32f2f,#e57373);">
                        <tr>
                            <th class="px-4 py-3">ID</th>
                            <th class="px-4 py-3">Objet</th>
                            <th class="px-4 py-3">Date de création</th>
                            <th class="px-4 py-3">Statut</th>
                            <th class="px-4 py-3">Priorité</th>
                            <th class="px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for reclamation in reclamations %}
                        <tr>
                            <td class="px-4 align-middle">{{ reclamation.idReclamation }}</td>
                            <td class="px-4 align-middle fw-bold">{{ reclamation.objet }}</td>
                            <td class="px-4 align-middle">{{ reclamation.dateCreation }}</td>
                            <td class="px-4 align-middle">
                                {% if reclamation.statut == 'Résolu' %}
                                    <span class="badge bg-success">{{ reclamation.statut }}</span>
                                {% elseif reclamation.statut == 'En cours' %}
                                    <span class="badge bg-warning text-dark">{{ reclamation.statut }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ reclamation.statut }}</span>
                                {% endif %}
                            </td>
                            <td class="px-4 align-middle">
                                {% if reclamation.priorite == 'Urgente' or reclamation.priorite == 'Élevée' %}
                                    <span class="badge bg-danger">{{ reclamation.priorite }}</span>
                                {% else %}
                                    <span class="badge bg-info text-dark">{{ reclamation.priorite }}</span>
                                {% endif %}
                            </td>
                            <td class="px-4 align-middle text-end">
                                <a href="{{ path('app_reclamation_show', {'idReclamation': reclamation.idReclamation}) }}" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_reclamation_edit', {'idReclamation': reclamation.idReclamation}) }}" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Aucune réclamation trouvée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'agriculteur.html.twig' %}

{% block title %}Analyser une Culture par Image{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card shadow border-0" style="border-radius: 18px; overflow: hidden;">
                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(135deg, #2d6a4f, #52b788); position: relative;">
                        <h3 class="mb-0">📸 Analyser une Culture</h3>
                        <p class="mb-0 mt-1" style="opacity: 0.85; font-size: 0.9rem;">
                            Uploadez une image pour identifier automatiquement le nom et le type de culture
                        </p>
                    </div>

                    <div class="card-body p-5">


                        {# ── Zone d'upload ── #}
                        <div class="mb-4">
                            <label class="form-label fw-bold">📷 Sélectionner une image *</label>

                            <div id="uploadZone"
                                 style="border: 3px dashed #52b788; border-radius: 12px; padding: 40px 20px;
                                        text-align: center; cursor: pointer; transition: all 0.3s ease;
                                        background: #f0f7f4;">
                                <div style="font-size: 3rem; margin-bottom: 10px;">📁</div>
                                <p style="margin: 0; color: #2d6a2d; font-weight: 600;">
                                    Cliquez ou déposez votre image ici
                                </p>
                                <small style="color: #666;">
                                    Formats supportés: JPEG, PNG, GIF, WebP (max 10 MB)
                                </small>
                                <input type="file" id="imageInput" accept="image/*" style="display: none;">
                            </div>
                        </div>

                        {# ── Prévisualisation ── #}
                        <div id="previewContainer" class="d-none mb-4">
                            <label class="form-label fw-bold">Prévisualisation</label>
                            <img id="imagePreview" src="" alt="Prévisualisation"
                                 style="max-width: 100%; max-height: 300px; border-radius: 8px;">
                            <button type="button" id="btnClearImage" class="btn btn-sm btn-outline-danger mt-2">
                                ❌ Changer d'image
                            </button>
                        </div>

                        {# ── Bouton d'analyse ── #}
                        <div id="analyzeButtonContainer" class="d-none mb-4">
                            <button type="button" id="btnAnalyze" class="btn w-100 py-3"
                                    style="background: linear-gradient(135deg, #2d6a4f, #52b788);
                                           color: white; font-weight: 600; border-radius: 8px;">
                                <span id="analyzeIcon">🔍</span>
                                <span id="analyzeText" class="ms-2">Analyser l'image</span>
                                <span id="analyzeLoading" class="d-none ms-2">
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    Analyse en cours...
                                </span>
                            </button>
                        </div>

                        {# ── Panneau de résultats ── #}
                        <div id="resultPanel" class="d-none mt-4"
                             style="border-radius: 12px; overflow: hidden; border: 2px solid #52b788;
                                    box-shadow: 0 4px 15px rgba(82, 183, 136, 0.2);">

                            <div style="background: linear-gradient(135deg, #2d6a4f, #52b788);
                                       color: white; padding: 20px;">
                                <h5 class="mb-0">✅ Résultats de l'analyse</h5>
                            </div>

                            <div style="background: #f8fdf8; padding: 25px;">


                                {# Plante identifiée sur l’image (PlantNet) #}
                                <div class="mb-4 p-3" style="background: white; border-radius: 8px; border-left: 4px solid #52b788;">
                                    <div style="font-weight: 600; color: #2d6a2d; font-size: 0.9rem; text-transform: uppercase; margin-bottom: 8px;">
                                        🌿 Plante identifiée (image)
                                    </div>
                                    <div style="font-size: 1.4rem; color: #2d6a2d; font-weight: bold;" id="resultCulture">
                                        —
                                    </div>
                                </div>

                                    {# Niveau de confiance #}
                                    <div class="col-12">
                                        <div class="p-3" style="background: white; border-radius: 8px; border-left: 4px solid #f9a825;">
                                            <div style="font-weight: 600; color: #e65100; font-size: 0.9rem; text-transform: uppercase; margin-bottom: 8px;">
                                                📊 Confiance de détection
                                            </div>
                                            <div style="font-size: 1.1rem; color: #e65100;" id="resultConfiance">
                                                —
                                            </div>
                                        </div>
                                    </div>

                                {# Labels détectés #}
                                <div id="labelsContainer" class="d-none mt-4 p-3" style="background: white; border-radius: 8px;">
                                    <div style="font-weight: 600; color: #2d6a2d; font-size: 0.9rem; text-transform: uppercase; margin-bottom: 12px;">
                                        🏷️ Labels détectés
                                    </div>
                                    <div id="labelsList" style="display: flex; flex-wrap: wrap; gap: 8px;">
                                    </div>
                                </div>

                                {# Actions #}
                                <div class="mt-4 d-flex gap-2">
                                    <button type="button" id="btnCreateCulture" class="btn btn-success flex-grow-1">
                                        ➕ Créer cette culture
                                    </button>
                                    <button type="button" id="btnNewAnalysis" class="btn btn-outline-secondary">
                                        🔄 Nouvelle analyse
                                    </button>
                                </div>
                            </div>
                        </div>

                        {# ── Panneau d'erreur ── #}
                        <div id="errorPanel" class="d-none mt-4 alert alert-danger d-flex align-items-center gap-2"
                             style="border-radius: 8px;">
                            <span style="font-size: 1.3rem;">⚠️</span>
                            <div>
                                <strong>Erreur lors de l'analyse</strong>
                                <div id="errorMessage" style="font-size: 0.9rem; margin-top: 4px;"></div>
                            </div>
                        </div>

                    </div>
                </div>

                {# Info utiles #}
                <div class="mt-4 alert alert-info" style="border-radius: 8px;">
                    <strong>💡 Conseil:</strong> Pour de meilleurs résultats, utilisez une image claire et bien éclairée de la culture.
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
const uploadZone = document.getElementById('uploadZone');
const imageInput = document.getElementById('imageInput');
const previewContainer = document.getElementById('previewContainer');
const imagePreview = document.getElementById('imagePreview');
const analyzeButtonContainer = document.getElementById('analyzeButtonContainer');
const btnAnalyze = document.getElementById('btnAnalyze');
const btnClearImage = document.getElementById('btnClearImage');
const resultPanel = document.getElementById('resultPanel');
const errorPanel = document.getElementById('errorPanel');

// ─────────────────────────────────────────────────────────────
// Gestion du drag & drop
// ─────────────────────────────────────────────────────────────
uploadZone.addEventListener('click', () => imageInput.click());

uploadZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadZone.style.background = '#e8f5e9';
    uploadZone.style.borderColor = '#2d6a4f';
});

uploadZone.addEventListener('dragleave', () => {
    uploadZone.style.background = '#f0f7f4';
    uploadZone.style.borderColor = '#52b788';
});

uploadZone.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.style.background = '#f0f7f4';
    uploadZone.style.borderColor = '#52b788';

    const files = e.dataTransfer.files;
    if (files.length > 0) {
        imageInput.files = files;
        handleFileSelect();
    }
});

imageInput.addEventListener('change', handleFileSelect);

function handleFileSelect() {
    const file = imageInput.files[0];

    if (!file) return;

    // Valider le type
    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
    if (!allowedTypes.includes(file.type)) {
        showError('Format d\'image non supporté. Utilisez JPEG, PNG, GIF ou WebP.');
        return;
    }

    // Valider la taille (10 MB max)
    if (file.size > 10 * 1024 * 1024) {
        showError('L\'image ne doit pas dépasser 10 MB.');
        return;
    }

    // Afficher la prévisualisation
    const reader = new FileReader();
    reader.onload = (e) => {
        imagePreview.src = e.target.result;
        previewContainer.classList.remove('d-none');
        analyzeButtonContainer.classList.remove('d-none');
        uploadZone.style.display = 'none';
        errorPanel.classList.add('d-none');
        resultPanel.classList.add('d-none');
    };
    reader.readAsDataURL(file);
}

btnClearImage.addEventListener('click', () => {
    imageInput.value = '';
    previewContainer.classList.add('d-none');
    analyzeButtonContainer.classList.add('d-none');
    uploadZone.style.display = 'block';
    resultPanel.classList.add('d-none');
    errorPanel.classList.add('d-none');
});

// ─────────────────────────────────────────────────────────────
// Analyse de l'image
// ─────────────────────────────────────────────────────────────
btnAnalyze.addEventListener('click', async function() {
    const file = imageInput.files[0];
    if (!file) {
        showError('Aucun fichier sélectionné.');
        return;
    }

    // État chargement
    document.getElementById('analyzeIcon').classList.add('d-none');
    document.getElementById('analyzeText').classList.add('d-none');
    document.getElementById('analyzeLoading').classList.remove('d-none');
    btnAnalyze.disabled = true;
    errorPanel.classList.add('d-none');
    resultPanel.classList.add('d-none');

    try {
        const formData = new FormData();
        formData.append('image', file);

        const response = await fetch('/api/culture/analyse-image', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (!data.success) {
            showError(data.message || 'Erreur lors de l\'analyse.');
            return;
        }

        // Afficher les résultats
        displayResults(data.data);
        resultPanel.classList.remove('d-none');
        resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    } catch (err) {
        showError('Erreur réseau. Vérifiez votre connexion et réessayez.');
    } finally {
        document.getElementById('analyzeIcon').classList.remove('d-none');
        document.getElementById('analyzeText').classList.remove('d-none');
        document.getElementById('analyzeLoading').classList.add('d-none');
        btnAnalyze.disabled = false;
    }
});
function displayResults(data) {
    // Plante sur l’image (PlantNet)
    document.getElementById('resultCulture').textContent =
        data.cultureDetectee || data.plante_detectee || '—';

    // Confiance
    const confiance = data.confiance || 0;
    document.getElementById('resultConfiance').innerHTML =
        `${confiance}% <div style="font-size: 0.8rem; color: #999;">de confiance</div>`;

    // Labels détectés
    if (data.labels && data.labels.length > 0) {
        const labelsHtml = data.labels
            .slice(0, 10)
            .map(label =>
                `<span style="background: #e8f5e9; color: #2d6a4f; padding: 4px 10px; border-radius: 20px; font-size: 0.85rem;">
                    ${escapeHtml(label.description)} (${(label.score * 100).toFixed(0)}%)
                </span>`
            )
            .join('');

        document.getElementById('labelsList').innerHTML = labelsHtml;
        document.getElementById('labelsContainer').classList.remove('d-none');
    } else {
        document.getElementById('labelsContainer').classList.add('d-none');
    }

    // Stocker les données pour création de culture
    window.analyzeResult = data;
}

function showError(message) {
    document.getElementById('errorMessage').textContent = message;
    errorPanel.classList.remove('d-none');
}

// ─────────────────────────────────────────────────────────────
// Créer une culture à partir des résultats
// ─────────────────────────────────────────────────────────────
document.getElementById('btnCreateCulture').addEventListener('click', () => {
    if (!window.analyzeResult) return;

    const result = window.analyzeResult;
    const nom = (result.culture && result.culture.nom) ? result.culture.nom : (result.cultureDetectee || result.plante_detectee || '');
    const type = (result.culture && result.culture.type) ? result.culture.type : (result.typeDetecte || '');

    const params = new URLSearchParams({
        nom: nom,
        type: type,
        image: imagePreview.src
    });

    window.location.href = `/culture/new?${params.toString()}`;
});

document.getElementById('btnNewAnalysis').addEventListener('click', () => {
    imageInput.value = '';
    previewContainer.classList.add('d-none');
    analyzeButtonContainer.classList.add('d-none');
    uploadZone.style.display = 'block';
    resultPanel.classList.add('d-none');
    errorPanel.classList.add('d-none');
});

// Utilitaires
function escapeHtml(text) {
    const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
    };
    return text.replace(/[&<>"']/g, m => map[m]);
}
</script>
{% endblock %}


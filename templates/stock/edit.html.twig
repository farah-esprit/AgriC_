{% extends app.session.get('user_role') == 'FOURNISSEUR' ? 'fournisseur.html.twig' : (app.session.get('user_role') == 'AGRICULTEUR' ? 'agriculteur.html.twig' : 'base.html.twig') %}


{% block title %}Modifier un Stock{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .input-group-text {
        background: linear-gradient(to bottom, #4a7c3a, #66bb6a);
        color: white;
        border: none;
    }
    .form-control:focus, .form-select:focus {
        border-color: #66bb6a;
        box-shadow: 0 0 0 0.2rem rgba(102, 187, 106, 0.25);
    }
    .produit-info {
        background: #f0f7ee;
        border-left: 4px solid #4a7c3a;
        border-radius: 5px;
        padding: 10px 15px;
        margin-bottom: 20px;
    }
</style>
{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow border-0" style="border-radius: 15px;">
                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(to right, #4a7c3a, #66bb6a); border-radius: 15px 15px 0 0;">
                        <h3>✏️ Modifier le Stock</h3>
                        {% if stock.produit %}
                            <p class="mb-0 opacity-75">{{ stock.produit.nom }}</p>
                        {% endif %}
                    </div>
                    <div class="card-body p-5">

                        {% for message in app.flashes('danger') %}
                            <div class="alert alert-danger alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}

                        {% if stock.produit %}
                        <div class="produit-info">
                            <i class="bi bi-box-seam-fill text-success"></i>
                            <strong> Produit :</strong> {{ stock.produit.nom }}
                            <span class="badge bg-success ms-2">{{ stock.produit.categorie }}</span>
                        </div>
                        {% endif %}

                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.produit, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-box-seam-fill"></i></span>
                                {{ form_widget(form.produit, {'attr': {'class': 'form-select' ~ (form.produit.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            </div>
                            {{ form_errors(form.produit) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.quantite, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-stack"></i></span>
                                {{ form_widget(form.quantite, {'attr': {'class': 'form-control' ~ (form.quantite.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                                <span class="input-group-text">unités</span>
                            </div>
                            {{ form_errors(form.quantite) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.disponible, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>
                                {{ form_widget(form.disponible, {'attr': {'class': 'form-control' ~ (form.disponible.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                                <span class="input-group-text">unités</span>
                            </div>
                            {{ form_errors(form.disponible) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.seuilAlert, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-exclamation-triangle-fill"></i></span>
                                {{ form_widget(form.seuilAlert, {'attr': {'class': 'form-control' ~ (form.seuilAlert.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                                <span class="input-group-text">unités</span>
                            </div>
                            <small class="text-muted">Une alerte sera déclenchée si le stock descend sous ce seuil</small>
                            {{ form_errors(form.seuilAlert) }}
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success flex-grow-1 py-2">
                                <i class="bi bi-check-circle"></i> Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_stock_index') }}" class="btn btn-outline-secondary py-2">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
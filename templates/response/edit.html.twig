{% extends 'base.html.twig' %}

{% block title %}Modifier la réponse - Forum AgriConnect{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forum.css') }}">
{% endblock %}

{% block body %}
<div class="container">
    <div class="forum-header">
        <h1>🌾 Modifier votre réponse</h1>
        <p class="subtitle">Mettez à jour votre contribution au sujet</p>
    </div>

    <div class="nav">
        <div class="nav-links">
            <a href="{{ path('thread_show', {'id': response.thread.id}) }}">← Retour au sujet</a>
            <a href="{{ path('thread_index') }}">Accueil</a>
        </div>
    </div>

    <div class="form-container">
        <div class="card">
            {% if errors is defined and errors.content is defined %}
                <div class="alert alert-error">
                    {{ errors.content }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('response_edit', {'id': response.id}) }}">
                <div class="form-group">
                    <label for="content">Votre réponse</label>
                    <textarea id="content" name="content" rows="8" class="form-control">{{ response.content }}</textarea>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 30px;">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a href="{{ path('thread_show', {'id': response.thread.id}) }}" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

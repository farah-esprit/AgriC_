{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de bord - Admin{% endblock %}

{% block admin_content %}

<style>
    .stat-card {
        transition: all 0.3s ease;
        border-radius: 14px;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .icon-box {
        border-radius: 12px;
        padding: 14px;
    }

    .card-title i {
        font-size: 1.1rem;
    }
</style>

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fas fa-chart-line text-success me-2"></i>Tableau de bord
        </h2>
        <small class="text-muted">
            Bienvenue, {{ app.session.get('admin_prenom') }} {{ app.session.get('admin_nom') }}
        </small>
    </div>

    <span class="badge bg-success px-3 py-2">
        <i class="fas fa-circle me-1" style="font-size:0.6rem"></i> En ligne
    </span>
</div>

<!-- STATS -->
<div class="row g-4 mb-4">

    <!-- USERS -->
    <div class="col-md-4">
        <div class="card stat-card border-0 h-100" style="border-left:4px solid #1565c0;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box" style="background:#e3f2fd;">
                    <i class="fas fa-users fa-lg text-primary"></i>
                </div>
                <div>
                    <div class="text-muted small">Total utilisateurs</div>
                    <div class="fs-2 fw-bold text-primary">{{ total_users }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTIVE -->
    <div class="col-md-4">
        <div class="card stat-card border-0 h-100" style="border-left:4px solid #2e7d32;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box" style="background:#e8f5e9;">
                    <i class="fas fa-user-check fa-lg text-success"></i>
                </div>
                <div>
                    <div class="text-muted small">Comptes actifs</div>
                    <div class="fs-2 fw-bold text-success">{{ active_users }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BLOCKED -->
    <div class="col-md-4">
        <div class="card stat-card border-0 h-100" style="border-left:4px solid #c62828;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box" style="background:#ffebee;">
                    <i class="fas fa-user-lock fa-lg text-danger"></i>
                </div>
                <div>
                    <div class="text-muted small">Comptes bloqués</div>
                    <div class="fs-2 fw-bold text-danger">{{ blocked_users }}</div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- GRAPH + ACTIONS -->
<div class="row g-4 mb-4">

    <!-- GRAPH -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="fas fa-chart-bar text-success me-2"></i>Statistiques utilisateurs
                </h5>
                <canvas id="userChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="fas fa-bolt text-warning me-2"></i>Actions rapides
                </h5>

                <div class="d-grid gap-2">
                    <a href="{{ path('admin_users') }}" class="btn btn-outline-primary">
                        <i class="fas fa-users me-2"></i>Gérer utilisateurs
                    </a>

                    <a href="{{ path('admin_profile') }}" class="btn btn-outline-success">
                        <i class="fas fa-user-edit me-2"></i>Mon profil
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- INFO CARD -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="fw-bold mb-3">
            <i class="fas fa-info-circle text-info me-2"></i>Informations
        </h5>

        <ul class="list-unstyled mb-0">
            <li class="py-2 border-bottom">
                <i class="fas fa-envelope me-2 text-muted"></i>
                {{ app.session.get('admin_email') }}
            </li>

            <li class="py-2 border-bottom">
                <i class="fas fa-shield-alt me-2 text-muted"></i>
                Rôle : Administrateur
            </li>

            <li class="py-2">
                <i class="fas fa-clock me-2 text-muted"></i>
                {{ "now"|date("d/m/Y à H:i") }}
            </li>
        </ul>
    </div>
</div>

<!-- CHART SCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('userChart');

new Chart(ctx, {
    type: 'line',
    data: {
        labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin'],
        datasets: [{
            label: 'Utilisateurs',
            data: [5, 10, 8, 15, 20, 18],
            borderColor: '#4caf50',
            backgroundColor: 'rgba(76, 175, 80, 0.1)',
            fill: true,
            tension: 0.4
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false }
        }
    }
});
</script>

{% endblock %}
{% extends app.session.get('user_role') == 'FOURNISSEUR' ? 'fournisseur.html.twig' : 'agriculteur.html.twig' %}

{% block title %}Modifier la réponse - Forum AgriConnect{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="forum-header">
    <div class="container text-center">
        <h1 class="forum-title">Modifier votre réponse</h1>
        <p class="forum-subtitle">Apportez les corrections nécessaires à votre message.</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-premium-card shadow-lg border-0">
                <div class="mb-4 pb-3 border-bottom">
                    <h5 class="fw-bold text-dark">Sujet : {{ response.thread.title }}</h5>
                </div>

                {{ form_start(form) }}
                    <div class="text-danger mb-3">{{ form_errors(form) }}</div>
                    <div class="mb-4">
                        <label class="fw-bold fs-5 mb-2 text-dark">Votre message</label>
                        {{ form_widget(form.content, {'attr': {'class': 'form-control form-control-agri', 'rows': '8'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.content) }}</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                        <a href="{{ path('thread_show', {'id': response.thread.id}) }}" class="btn btn-link text-muted text-decoration-none fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-agri px-5 py-3 fs-5">
                            <i class="bi bi-check-circle me-2"></i> Enregistrer les modifications
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

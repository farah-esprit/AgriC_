{% extends app.session.get('user_role') == 'FOURNISSEUR' ? 'fournisseur.html.twig' : (app.session.get('user_role') == 'AGRICULTEUR' ? 'agriculteur.html.twig' : 'base.html.twig') %}

{% block title %}Gestion des Commandes{% endblock %}

{% block body %}

<section class="hero-section" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{{ asset('assets/img/hero_1.jpg') }}'); background-size: cover; padding: 120px 0 60px;">
    <div class="container text-center text-white">
        <h1>🛒 Gestion des Commandes</h1>
        <p>Suivez et gérez vos commandes</p>
    </div>
</section>

<section class="py-5">
    <div class="container">

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <!-- Statistiques -->
        <div class="row mb-4">
            <div class="col-md-2">
                <div class="card text-white text-center p-3"
                     style="background: linear-gradient(to right, #4a7c3a, #66bb6a); border-radius: 15px;">
                    <h2>{{ commandes|length }}</h2>
                    <p class="mb-0">Total</p>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white text-center p-3 bg-warning" style="border-radius: 15px;">
                    <h2>{{ commandes|filter(c => c.statut == 'EN_ATTENTE')|length }}</h2>
                    <p class="mb-0">En attente</p>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white text-center p-3 bg-success" style="border-radius: 15px;">
                    <h2>{{ commandes|filter(c => c.statut == 'VALIDEE')|length }}</h2>
                    <p class="mb-0">Validées</p>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white text-center p-3 bg-info" style="border-radius: 15px;">
                    <h2>{{ commandes|filter(c => c.statut == 'EXPEDIEE')|length }}</h2>
                    <p class="mb-0">Expédiées</p>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white text-center p-3 bg-primary" style="border-radius: 15px;">
                    <h2>{{ commandes|filter(c => c.statut == 'LIVREE')|length }}</h2>
                    <p class="mb-0">Livrées</p>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white text-center p-3 bg-danger" style="border-radius: 15px;">
                    <h2>{{ commandes|filter(c => c.statut == 'ANNULEE')|length }}</h2>
                    <p class="mb-0">Annulées</p>
                </div>
            </div>
        </div>

        <!-- Barre actions -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-success">🛒 Commandes</h2>
            <div class="d-flex gap-2">
                <input type="text" id="recherche" class="form-control"
                       placeholder="🔍 Rechercher..." style="width: 250px;">
                <select id="filtreStatut" class="form-select" style="width: 180px;">
                    <option value="">Tous les statuts</option>
                    <option value="EN_ATTENTE">⏳ En attente</option>
                    <option value="VALIDEE">✅ Validée</option>
                    <option value="EXPEDIEE">🚚 Expédiée</option>
                    <option value="LIVREE">📦 Livrée</option>
                    <option value="ANNULEE">❌ Annulée</option>
                </select>
                <a href="{{ path('app_commande_new') }}" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Ajouter
                </a>
            </div>
        </div>

        <!-- Cartes Commandes -->
        <div class="row" id="commandes-container">
            {% for commande in commandes %}

            {% if commande.statut == 'LIVREE' %}
                {% set couleur_statut = 'primary' %}
                {% set icon_statut = '📦' %}
                {% set label_statut = 'LIVRÉE' %}
            {% elseif commande.statut == 'EN_ATTENTE' %}
                {% set couleur_statut = 'warning' %}
                {% set icon_statut = '⏳' %}
                {% set label_statut = 'EN ATTENTE' %}
            {% elseif commande.statut == 'VALIDEE' %}
                {% set couleur_statut = 'success' %}
                {% set icon_statut = '✅' %}
                {% set label_statut = 'VALIDÉE' %}
            {% elseif commande.statut == 'EXPEDIEE' %}
                {% set couleur_statut = 'info' %}
                {% set icon_statut = '🚚' %}
                {% set label_statut = 'EXPÉDIÉE' %}
            {% elseif commande.statut == 'ANNULEE' %}
                {% set couleur_statut = 'danger' %}
                {% set icon_statut = '❌' %}
                {% set label_statut = 'ANNULÉE' %}
            {% elseif commande.statut == 'PAYEE' %}
                {% set couleur_statut = 'success' %}
                {% set icon_statut = '💳' %}
                {% set label_statut = 'PAYÉE' %}
            {% else %}
                {% set couleur_statut = 'secondary' %}
                {% set icon_statut = '🔄' %}
                {% set label_statut = commande.statut %}
            {% endif %}

            <div class="col-lg-3 col-md-4 col-sm-6 mb-4 commande-card"
                 data-nom="{{ commande.produit ? commande.produit.nom|lower : '' }}"
                 data-statut="{{ commande.statut }}">
                <div class="card h-100 shadow-sm border-0
                    {{ commande.statut == 'PAYEE' ? 'border border-success' : '' }}"
                     style="border-radius: 15px;">

                    <div class="position-absolute top-0 end-0 m-2">
                        <span class="badge bg-{{ couleur_statut }}">{{ icon_statut }} {{ label_statut }}</span>
                    </div>

                    <div class="text-center pt-4">
                        {% if commande.produit and commande.produit.imagePath %}
                            <img src="{{ asset('uploads/images/' ~ commande.produit.imagePath) }}"
                                 class="rounded-circle" width="90" height="90"
                                 style="object-fit: cover; border: 3px solid #5a8c4a;">
                        {% else %}
                            <div class="rounded-circle bg-success d-inline-flex align-items-center justify-content-center"
                                 style="width:90px; height:90px; font-size:36px;">
                                🛒
                            </div>
                        {% endif %}
                    </div>

                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">
                            {{ commande.produit ? commande.produit.nom : 'Produit inconnu' }}
                        </h5>
                        {% if commande.produit %}
                            <span class="badge bg-success mb-2">{{ commande.produit.categorie }}</span>
                        {% endif %}

                        <div class="mt-3">
                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="fw-bold text-primary">{{ commande.quantiteCommandee }}</div>
                                    <div class="small text-muted">Quantité</div>
                                </div>
                                <div class="col-6">
                                    <div class="fw-bold text-success">
                                        {% if commande.prixTotal %}
                                            {{ commande.prixTotal|number_format(2) }} DT
                                        {% elseif commande.produit %}
                                            {{ (commande.produit.prix * commande.quantiteCommandee)|number_format(2) }} DT
                                        {% else %}
                                            -
                                        {% endif %}
                                    </div>
                                    <div class="small text-muted">Total</div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="bi bi-calendar"></i> {{ commande.dateCommande }}
                            </small>
                        </div>

                        {% if commande.user %}
                            <div class="mt-1">
                                <small class="text-muted">
                                    <i class="bi bi-person"></i> {{ commande.user.nom ?? 'Utilisateur' }}
                                </small>
                            </div>
                        {% endif %}
                    </div>

                    <div class="card-footer bg-transparent border-0 text-center pb-3">

                        <!-- ✅ Bouton Payer -->
                        {% if commande.statut != 'PAYEE' and commande.statut != 'ANNULEE' %}
                            <a href="{{ path('app_payment_checkout', {'id': commande.idCommande}) }}"
                               class="btn btn-sm btn-success w-100 mb-2 fw-bold">
                                <i class="bi bi-credit-card"></i> 💳 Payer {{ commande.prixTotal ? commande.prixTotal|number_format(2) : '' }} DT
                            </a>
                        {% elseif commande.statut == 'PAYEE' %}
                            <div class="alert alert-success py-1 mb-2">
                                <small>💳 Commande payée ✅</small>
                            </div>
                        {% endif %}

                        <!-- Modifier / Supprimer -->
                        <div class="d-flex justify-content-center gap-1">
                            <a href="{{ path('app_commande_edit', {'id': commande.idCommande}) }}"
                               class="btn btn-sm btn-outline-success">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('app_commande_delete', {'id': commande.idCommande}) }}"
                                  style="display:inline"
                                  onsubmit="return confirm('Supprimer cette commande ?')">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete' ~ commande.idCommande) }}">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            {% else %}
            <div class="col-12 text-center py-5">
                <h4 class="text-muted">Aucune commande trouvée 🛒</h4>
                <a href="{{ path('app_commande_new') }}" class="btn btn-success mt-3">Ajouter une commande</a>
            </div>
            {% endfor %}
        </div>

    </div>
</section>

{% endblock %}

{% block javascripts %}
<script>
document.getElementById('recherche').addEventListener('input', filtrer);
document.getElementById('filtreStatut').addEventListener('change', filtrer);

function filtrer() {
    const recherche = document.getElementById('recherche').value.toLowerCase();
    const statut = document.getElementById('filtreStatut').value;

    document.querySelectorAll('.commande-card').forEach(card => {
        const nomMatch = card.dataset.nom.includes(recherche);
        const statutMatch = statut === '' || card.dataset.statut === statut;
        card.style.display = (nomMatch && statutMatch) ? '' : 'none';
    });
}
</script>
{% endblock %}
{% extends 'agriculteur.html.twig' %}

{% block title %}Détail Diagnostic{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">

                <div class="card shadow border-0" style="border-radius: 15px;">
                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(to right, #4a7c3a, #66bb6a); border-radius: 15px 15px 0 0;">
                        <h3>🩺 Diagnostic #{{ diagnostic.idDiagnostic }}</h3>
                    </div>

                    <div class="card-body p-5">
                        <table class="table table-bordered">
                            <tr>
                                <th style="color: #4a7c3a;">🔢 ID</th>
                                <td>{{ diagnostic.idDiagnostic }}</td>
                            </tr>
                            <tr>
                                <th style="color: #4a7c3a;">📅 Date</th>
                                <td>{{ diagnostic.dateDiagnostic }}</td>
                            </tr>
                            <tr>
                                <th style="color: #4a7c3a;">🌿 Culture</th>
                                <td>
                                    {% if culture %}
                                        <span class="badge" style="background-color: #66bb6a;">
                                            {{ culture.nom }} ({{ culture.type }})
                                        </span>
                                    {% else %}
                                        ID : {{ diagnostic.idCulture }}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th style="color: #4a7c3a;">🤒 Symptômes</th>
                                <td>{{ diagnostic.symptomes }}</td>
                            </tr>
                            <tr>
                                <th style="color: #4a7c3a;">📝 Infos complémentaires</th>
                                <td>{{ diagnostic.informationsComplementaires ?? '-' }}</td>
                            </tr>
                        </table>

                        <div class="d-flex gap-2 mt-3">
                            <a href="{{ path('app_diagnostic_edit', {'id': diagnostic.idDiagnostic}) }}"
                               class="btn btn-warning flex-grow-1">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <a href="{{ path('app_diagnostic_index') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}

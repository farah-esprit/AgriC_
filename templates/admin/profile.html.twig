{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mon Profil - Admin{% endblock %}

{% block admin_content %}

<div class="mb-4">
    <h2 class="mb-0 fw-bold"><i class="fas fa-user-edit text-success me-2"></i>Mon Profil</h2>
    <small class="text-muted">Gérez vos informations personnelles</small>
</div>

<div class="row g-4">

    <!-- FORMULAIRE -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold"><i class="fas fa-pen me-2 text-success"></i>Modifier mes informations</h5>
            </div>
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">NOM</label>
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Votre nom'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.nom) }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">PRÉNOM</label>
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Votre prénom'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.prenom) }}</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">📧 Adresse email *</label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'readonly': 'readonly'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">TÉLÉPHONE</label>
                    {{ form_widget(form.telephone, {'attr': {'class': 'form-control form-control-lg', 'placeholder': '+216 XX XXX XXX'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.telephone) }}</div>
                </div>

                <hr class="my-4">

                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted small">NOUVEAU MOT DE PASSE</label>
                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Laisser vide pour ne pas changer'}}) }}
                    <div class="form-text text-muted">
                        <i class="fas fa-info-circle me-1"></i>Laissez vide pour conserver votre mot de passe actuel
                    </div>
                    <div class="text-danger small mt-1">{{ form_errors(form.plainPassword) }}</div>
                </div>

                <div class="d-flex gap-2">
                    {{ form_widget(form.submit, {'attr': {'class': 'btn btn-success btn-lg px-5', 'style': 'border-radius:10px;'}}) }}
                    <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary btn-lg px-4" style="border-radius:10px;">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- INFOS COMPTE -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body text-center p-4">
                <div style="width:80px;height:80px;border-radius:50%;background:#e8f5e9;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:2rem;font-weight:700;color:#2e7d32;">
                    {{ admin.prenom|slice(0,1)|upper }}
                </div>
                <h5 class="fw-bold mb-0">{{ admin.prenom }} {{ admin.nom }}</h5>
                <small class="text-muted">{{ admin.email }}</small>
                <div class="mt-3">
                    <span class="badge px-3 py-2" style="background:#e8f5e9;color:#2e7d32;border-radius:20px;">
                        <i class="fas fa-shield-alt me-1"></i>Administrateur
                    </span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2 text-info"></i>Informations compte</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                        <span class="text-muted small"><i class="fas fa-envelope me-2"></i>Email</span>
                        <span class="small fw-semibold">{{ admin.email }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                        <span class="text-muted small"><i class="fas fa-phone me-2"></i>Téléphone</span>
                        <span class="small fw-semibold">{{ admin.telephone ?? '—' }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                        <span class="text-muted small"><i class="fas fa-calendar me-2"></i>Inscrit le</span>
                        <span class="small fw-semibold">{{ admin.dateCreation ? admin.dateCreation|date('d/m/Y') : '—' }}</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

</div>

{% endblock %}

{% extends app.session.get('user_role') == 'FOURNISSEUR' ? 'fournisseur.html.twig' : 'agriculteur.html.twig' %}

{% block title %}Administration Forum - AgriConnect{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
    <style>
        .admin-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: var(--agri-shadow);
            margin-bottom: 30px;
        }
        .table img {
            width: 30px;
            height: 30px;
            border-radius: 50%;
        }
    </style>
{% endblock %}

{% block body %}
<div class="forum-header" style="height: 180px; padding-top: 80px;">
    <div class="container d-flex justify-content-between align-items-center">
        <h1 class="forum-title">Administration Forum</h1>
        <a href="{{ path('thread_index') }}" class="btn btn-outline-light rounded-pill px-4">
            <i class="bi bi-eye"></i> Voir le forum
        </a>
    </div>
</div>

<div class="container pb-5" style="margin-top: -40px;">
    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row">
        {# Liste des Sujets #}
        <div class="col-lg-12">
            <div class="admin-card border-0">
                <h4 class="fw-bold mb-4 text-success border-bottom pb-2">Gestion des Sujets ({{ threads|length }})</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Sujet</th>
                                <th>Auteur</th>
                                <th>Date</th>
                                <th>Statistiques</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for thread in threads %}
                            <tr>
                                <td>
                                    <div class="fw-bold">{{ thread.title }}</div>
                                    <small class="text-muted">{{ thread.category }}</small>
                                </td>
                                <td>{{ thread.user.nom }}</td>
                                <td>{{ thread.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <span class="badge bg-light text-dark"><i class="bi bi-chat-text"></i> {{ thread.responses|length }}</span>
                                    <span class="badge bg-light text-dark"><i class="bi bi-heart"></i> {{ thread.likeCount }}</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a href="{{ path('thread_show', {'id': thread.id}) }}" class="btn btn-sm btn-outline-success"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('thread_edit', {'id': thread.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('thread_delete', {'id': thread.id}) }}" onsubmit="return confirm('Attention : suppression définitive du sujet et de toutes ses réponses !');" style="display:inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ thread.id) }}">
                                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Liste des Réponses #}
        <div class="col-lg-12">
            <div class="admin-card border-0">
                <h4 class="fw-bold mb-4 text-warning border-bottom pb-2">Gestion des Réponses ({{ responses|length }})</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Contenu</th>
                                <th>Sujet lié</th>
                                <th>Auteur</th>
                                <th>Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for response in responses %}
                            <tr>
                                <td class="text-truncate" style="max-width: 250px;">{{ response.content }}</td>
                                <td class="text-truncate" style="max-width: 200px;">{{ response.thread.title }}</td>
                                <td>{{ response.user.nom }}</td>
                                <td>{{ response.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a href="{{ path('response_edit', {'id': response.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('response_delete', {'id': response.id}) }}" onsubmit="return confirm('Supprimer cette réponse ?');" style="display:inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_response' ~ response.id) }}">
                                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

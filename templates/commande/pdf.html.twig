<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Facture #{{ commande.idCommande }}</title>
    <style>
        body { font-family: 'Helvetica', sans-serif; color: #333; line-height: 1.5; }
        .invoice-box { max-width: 800px; margin: auto; padding: 30px; border: 1px solid #eee; }
        .header { display: flex; justify-content: space-between; margin-bottom: 40px; border-bottom: 2px solid #5a8c4a; padding-bottom: 10px; }
        .logo { font-size: 24px; font-weight: bold; color: #5a8c4a; }
        .invoice-title { font-size: 20px; font-weight: bold; text-align: right; }
        .details { margin-bottom: 40px; }
        .details table { width: 100%; }
        .details td { vertical-align: top; }
        .items-table { width: 100%; border-collapse: collapse; margin-bottom: 40px; }
        .items-table th { background: #5a8c4a; color: white; text-align: left; padding: 10px; }
        .items-table td { padding: 10px; border-bottom: 1px solid #eee; }
        .total { text-align: right; font-size: 18px; font-weight: bold; margin-top: 20px; color: #5a8c4a; }
        .footer { text-align: center; font-size: 12px; color: #777; margin-top: 50px; border-top: 1px solid #eee; padding-top: 10px; }
    </style>
</head>
<body>
    <div class="invoice-box">
        <table width="100%">
            <tr>
                <td class="logo">AgriConnect</td>
                <td class="invoice-title">FACTURE #{{ commande.idCommande }}</td>
            </tr>
        </table>
        
        <div style="margin-top: 30px;"></div>

        <table width="100%" class="details">
            <tr>
                <td>
                    <strong>Émetteur :</strong><br>
                    AgriConnect Tunisie<br>
                    Avenue Habib Bourguiba, Tunis<br>
                    contact@agriconnect.tn
                </td>
                <td align="right">
                    <strong>Client :</strong><br>
                    {{ commande.user ? commande.user.nom : 'Client Anonyme' }}<br>
                    Date : {{ commande.dateCommande }}<br>
                    Statut : {{ commande.statut }}
                </td>
            </tr>
        </table>

        <table class="items-table">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Prix Unitaire</th>
                    <th>Quantité</th>
                    <th>Montant</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        {{ commande.produit ? commande.produit.nom : 'Produit inconnu' }}
                        {% if commande.produit %}
                            <br><small style="color: #666;">Catégorie : {{ commande.produit.categorie }}</small>
                        {% endif %}
                    </td>
                    <td>
                        {% if commande.produit %}
                            {{ (commande.prixTotal / commande.quantiteCommandee)|number_format(2) }} DT
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>{{ commande.quantiteCommandee }}</td>
                    <td>{{ commande.prixTotal|number_format(2) }} DT</td>
                </tr>
            </tbody>
        </table>

        <div class="total">
            TOTAL : {{ commande.prixTotal|number_format(2) }} DT
        </div>

        <div class="footer">
            Merci de votre confiance en AgriConnect.<br>
            Ceci est un document généré numériquement.
        </div>
    </div>
</body>
</html>

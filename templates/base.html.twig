
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{% block title %}AgriConnect{% endblock %}</title>

    <!-- Favicons -->
    <link href="{{ asset('assets/img/favicon.png') }}" rel="icon">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Raleway:300,300i,400,400i,500,500i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <!-- Vendor CSS -->
    <link href="{{ asset('assets/vendor/aos/aos.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="{{ asset('assets/vendor/glightbox/css/glightbox.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/swiper/swiper-bundle.min.css') }}" rel="stylesheet">

    <!-- Main CSS -->
    <link href="{{ asset('assets/css/main.css') }}" rel="stylesheet">

    <style>
        /* NAVBAR : boutons Connexion / Inscription style lien normal */
        .nav-buttons {
            display: inline-flex;
            gap: 15px;
            margin-left: 15px;
        }

        .nav-buttons a {
            text-decoration: none;
            color: #7BA00E;
            font-weight: 500;
            padding: 6px 12px;
            transition: color 0.2s, background-color 0.2s;
        }

        .nav-buttons a:hover {
            color: #5c7a0b;
        }

        /* Dropdown user */
        .dropdown-menu {
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-top: 10px;
        }

        .dropdown-item:hover {
            background-color: #f8f9fa;
            color: #7BA00E;
        }

        /* FOOTER en noir */
        #footer.footer {
            background-color: #000;
            color: #fff;
            padding: 40px 0;
        }

        #footer.footer a {
            color: #fff;
            text-decoration: none;
            transition: color 0.2s;
        }

        #footer.footer a:hover {
            color: #7BA00E;
        }
    </style>

    {% block stylesheets %}{% endblock %}

    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body>

    <!-- Header -->
    <header id="header" class="header d-flex align-items-center fixed-top">
        <div class="container-fluid container-xl d-flex align-items-center justify-content-between">

            <a href="{{ path('app_home') }}" class="logo d-flex align-items-center">
                <img src="{{ asset('assets/img/logo.png') }}" alt="AgriConnect">
                <span class="sitename">AgriConnect</span>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="#">À propos</a></li>
                    <li><a href="#">Nos Services</a></li>
                    <li><a href="#">Témoignages</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Contact</a></li>

                    {# ── CAS ADMIN connecté ── #}
                    {% if app.session.get('admin_id') %}
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-person-shield"></i>
                                {{ app.session.get('admin_prenom') }} <span style="color:#7BA00E;">(Admin)</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" href="{{ path('admin_users') }}"><i class="bi bi-people me-2"></i>Utilisateurs</a></li>
                                <li><a class="dropdown-item" href="{{ path('admin_profile') }}"><i class="bi bi-person-gear me-2"></i>Mon profil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('admin_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                            </ul>
                        </li>

                    {# ── CAS USER connecté ── #}
                    {% elseif app.session.get('user_id') %}
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> {{ app.session.get('user_name') }}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Mon profil</a></li>
                                <li><a class="dropdown-item" href="#">Mes commandes</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                            </ul>
                        </li>

                    {# ── CAS VISITEUR ── #}
                    {% else %}
                        <li class="nav-buttons">
                            <a href="{{ path('app_signin') }}">Connexion</a>
                            <a href="{{ path('app_signup') }}">Inscription</a>
                        </li>
                    {% endif %}

                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

        </div>
    </header>

    <!-- Main Content -->
    <main id="main">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer id="footer" class="footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-5 col-md-12 footer-info">
                    <a href="{{ path('app_home') }}" class="logo d-flex align-items-center">
                        <span class="sitename">AgriConnect</span>
                    </a>
                    <p>Plateforme de gestion agricole pour fournisseurs en Tunisie.</p>
                </div>
                <div class="col-lg-3 col-md-12 footer-links">
                    <h4>Liens utiles</h4>
                    <ul>
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="#">À propos</a></li>
                        <li><a href="#">Services</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12 footer-links">
                    <h4>Nos Services</h4>
                    <ul>
                        <li><a href="#">Plantation</a></li>
                        <li><a href="#">Arrosage</a></li>
                        <li><a href="#">Récolte</a></li>
                        <li><a href="#">Conseil agricole</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="container copyright text-center mt-4">
            <p>© <strong>AgriConnect</strong> - Tous droits réservés</p>
        </div>
    </footer>

    <!-- Vendor JS -->
    <script src="{{ asset('assets/vendor/aos/aos.js') }}"></script>
    <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/glightbox/js/glightbox.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/swiper/swiper-bundle.min.js') }}"></script>

    <!-- Main JS -->
    <script src="{{ asset('assets/js/main.js') }}"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
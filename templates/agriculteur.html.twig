<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{% block title %}AgriConnect{% endblock %}</title>

    <link href="{{ asset('assets/img/favicon.png') }}" rel="icon">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Raleway:300,300i,400,400i,500,500i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <link href="{{ asset('assets/vendor/aos/aos.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/glightbox/css/glightbox.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/main.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/premium-ui.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <style>
        .user-dropdown .dropdown-toggle {
            background: none;
            border: none;
            color: inherit;
            font-weight: 600;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 8px;
            transition: background 0.2s;
        }
        .user-dropdown .dropdown-toggle:hover {
            background: rgba(0,0,0,0.06);
        }
        .user-dropdown .dropdown-toggle::after {
            display: inline-block;
            margin-left: 4px;
            vertical-align: middle;
            content: "";
            border-top: 0.4em solid;
            border-right: 0.4em solid transparent;
            border-left: 0.4em solid transparent;
        }
        .user-dropdown .dropdown-menu {
            min-width: 200px;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            border: none;
            padding: 8px 0;
            right: 0;
            left: auto;
        }
        .user-dropdown .dropdown-item {
            padding: 10px 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: background 0.15s;
        }
        .user-dropdown .dropdown-item:hover {
            background: #f0f9f0;
            color: #2E7D32;
        }
        .user-dropdown .dropdown-item.text-danger:hover {
            background: #fff5f5;
            color: #dc3545 !important;
        }
        .user-dropdown .dropdown-divider {
            margin: 4px 0;
        }
        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        #footer {
            background-color: #000;
            color: #fff;
            padding: 40px 0;
        }
        #footer a {
            color: #fff;
            text-decoration: none;
        }
        #footer a:hover {
            color: #ccc;
        }

        /* Flash Toast premium */
        .toast-container {
            position: fixed;
            top: 100px;
            right: 20px;
            z-index: 1060;
        }
        .premium-toast {
            background: white;
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 15px;
            border-left: 5px solid #4CAF50;
            min-width: 300px;
            animation: slideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            transition: all 0.3s ease;
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(100%); }
            to { opacity: 1; transform: translateX(0); }
        }
        .premium-toast.success { border-left-color: #2E7D32; }
        .premium-toast.error { border-left-color: #d32f2f; }
        .premium-toast.warning { border-left-color: #ffa000; }
        .premium-toast.info { border-left-color: #1976d2; }
        
        .premium-toast .icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .premium-toast .message {
            font-size: 0.95rem;
            font-weight: 500;
            color: #333;
            flex-grow: 1;
        }
        .premium-toast .btn-close {
            padding: 0;
            margin: 0;
            font-size: 0.8rem;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

    <header id="header" class="header d-flex align-items-center fixed-top">
        <div class="container-fluid container-xl d-flex align-items-center justify-content-between">

            <a href="{{ path('app_home') }}" class="logo d-flex align-items-center">
                <img src="{{ asset('assets/img/logo.png') }}" alt="AgriConnect">
                <span class="sitename">AgriConnect</span>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_culture_index') }}">Mes Cultures</a></li>
                    <li><a href="{{ path('app_diagnostic_index') }}">Diagnostic</a></li>
                    <li><a href="{{ path('app_calendrier_index') }}">Calendrier IA</a></li>
                    <li><a href="{{ path('app_evenement_index') }}">Événements</a></li>
                    <li><a href="{{ path('app_reclamation_index') }}">Réclamations</a></li>
                    <li><a href="{{ path('thread_index') }}">Forum</a></li>
                    <li><a href="{{ path('app_commande_index') }}">Commandes</a></li>

                    {# ✅ Dropdown user #}
                    {% if app.session.get('user_id') %}
                    <li class="user-dropdown dropdown">
                        <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar">
                                {{ app.session.get('user_name')|first|upper }}
                            </span>
                            {{ app.session.get('user_name') }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <span class="dropdown-item-text px-4 py-2 text-muted" style="font-size:0.8rem;">
                                    👨‍🌾 Agriculteur
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('user_profil') }}">
                                    <i class="bi bi-person-circle"></i> Mon profil
                                </a>
                            </li>
                            {% if app.session.get('user_role') == 'EXPERT' %}
                            <li>
                                <a class="dropdown-item text-primary fw-bold" href="{{ path('forum_admin') }}">
                                    <i class="bi bi-shield-check"></i> Modération Forum
                                </a>
                            </li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                    {% endif %}
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

        </div>
    </header>

    <main id="main">
        {# Flash Messages centralized #}
        <div class="toast-container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="premium-toast {{ label }} shadow-lg d-flex align-items-center" role="alert">
                        <div class="icon">
                            {% if label == 'success' %}✅
                            {% elseif label == 'error' %}❌
                            {% elseif label == 'warning' %}⚠️
                            {% else %}ℹ️{% endif %}
                        </div>
                        <div class="message">{{ message }}</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" onclick="this.parentElement.remove()"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
        {% block body %}
        <section id="hero" class="hero section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <div class="p-5 bg-white rounded-4 shadow-sm mb-4">
                            <h2 class="text-dark fw-bold mb-3">Tableau de bord Agriculteur</h2>
                            <p class="text-muted">Gérez vos cultures, suivez les événements et échangez avec la communauté.</p>
                            
                            <hr class="my-4">
                            
                            <h4 class="fw-bold mb-4">Actions rapides</h4>
                            <div class="row g-4">
                                <div class="col-md-3">
                                    <a href="{{ path('app_culture_index') }}" class="d-block p-4 text-center border rounded-4 text-decoration-none hover-shadow transition-all" style="background: #f8fcf5;">
                                        <i class="bi bi-flower1 fs-1 text-success mb-2 d-block"></i>
                                        <span class="fw-bold text-dark">Mes Cultures</span>
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="{{ path('app_evenement_index') }}" class="d-block p-4 text-center border rounded-4 text-decoration-none hover-shadow transition-all" style="background: #fffcf0;">
                                        <i class="bi bi-calendar-event fs-1 text-warning mb-2 d-block"></i>
                                        <span class="fw-bold text-dark">Événements</span>
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="{{ path('thread_index') }}" class="d-block p-4 text-center border rounded-4 text-decoration-none hover-shadow transition-all" style="background: #f0f7ff;">
                                        <i class="bi bi-chat-dots fs-1 text-primary mb-2 d-block"></i>
                                        <span class="fw-bold text-dark">Forum Community</span>
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="{{ path('app_calendrier_index') }}" class="d-block p-4 text-center border rounded-4 text-decoration-none hover-shadow transition-all" style="background: #fdf2f8;">
                                        <i class="bi bi-calendar-check fs-1 text-info mb-2 d-block" style="color:#d946ef !important;"></i>
                                        <span class="fw-bold text-dark">Planning IA</span>
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="{{ path('app_reclamation_index') }}" class="d-block p-4 text-center border rounded-4 text-decoration-none hover-shadow transition-all" style="background: #fff5f5;">
                                        <i class="bi bi-exclamation-triangle fs-1 text-danger mb-2 d-block"></i>
                                        <span class="fw-bold text-dark">Réclamations</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        {% endblock %}
    </main>

    <footer id="footer" class="footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-5 col-md-12 footer-info">
                    <a href="{{ path('app_home') }}" class="logo d-flex align-items-center">
                        <span class="sitename">AgriConnect</span>
                    </a>
                    <p>Plateforme de gestion agricole pour agriculteurs en Tunisie.</p>
                </div>
                <div class="col-lg-3 col-md-12 footer-links">
                    <h4>Liens utiles</h4>
                    <ul>
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="{{ path('app_culture_index') }}">Mes Cultures</a></li>
                        <li><a href="{{ path('app_diagnostic_index') }}">Diagnostic</a></li>
                        <li><a href="{{ path('app_evenement_index') }}">Événements</a></li>
                        <li><a href="{{ path('app_reclamation_index') }}">Réclamations</a></li>
                        <li><a href="{{ path('app_commande_index') }}">Commandes</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="container copyright text-center mt-4">
            <p>© <strong>AgriConnect</strong> - Tous droits réservés</p>
        </div>
    </footer>

    <script src="{{ asset('assets/vendor/aos/aos.js') }}"></script>
    <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/glightbox/js/glightbox.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/swiper/swiper-bundle.min.js') }}"></script>
    <!-- Main JS -->
    <script src="{{ asset('assets/js/main.js') }}"></script>

    <script>
        // Auto-dismiss toasts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                var toasts = document.querySelectorAll('.premium-toast');
                toasts.forEach(function(toast) {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(20px)';
                    setTimeout(function() {
                        toast.remove();
                    }, 300);
                });
            }, 5000);
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            flatpickr(".js-flatpickr", {
                locale: "fr",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d F Y",
                allowInput: true
            });
            flatpickr(".js-flatpickr-time", {
                locale: "fr",
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                altInput: true,
                altFormat: "d F Y à H:i",
                time_24hr: true,
                allowInput: true
            });
        });
    </script>
    {% if app.request.attributes.get('_route') matches '/^app_(produit|stock|commande)/' %}
        {% include 'inc/_chatbot.html.twig' %}
    {% endif %}

    {% block javascripts %}{% endblock %}

        });
    </script>

</body>
</html>
{% extends 'agriculteur.html.twig' %}

{% block title %}Forum Communautaire - AgriConnect{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="forum-header">
    <div class="container text-center">
        <h1 class="forum-title">AgriConnect Forum</h1>
        <p class="forum-subtitle">L'espace d'échange privilégié pour les acteurs du monde agricole.</p>
    </div>
</div>

<div class="container pb-5">
    {# Search Floating Bar #}
    <div class="search-container col-lg-10 mx-auto">
        <form method="GET" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-success"></i></span>
                    <input type="text" name="title" class="form-control search-input" placeholder="Rechercher une discussion..." value="{{ current_title }}">
                </div>
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select border-0 fw-500 text-muted">
                    <option value="">Toutes les catégories</option>
                    <option value="Général" {% if current_category == 'Général' %}selected{% endif %}>Général</option>
                    <option value="Conseils" {% if current_category == 'Conseils' %}selected{% endif %}>Conseils</option>
                    <option value="Marché" {% if current_category == 'Marché' %}selected{% endif %}>Marché</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-agri w-100 py-2">Filtrer</button>
            </div>
            <div class="col-md-2">
                <a href="{{ path('thread_new') }}" class="btn btn-outline-success rounded-pill w-100 py-2 fw-bold">
                    <i class="bi bi-plus-lg"></i> Créer
                </a>
            </div>
        </form>
    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row g-4">
        {# Main Content #}
        <div class="col-lg-9">
            <div class="row g-4">
                {% for thread in threads %}
                    <div class="col-md-6">
                        <div class="forum-card">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="category-tag">{{ thread.category }}</span>
                                <span class="badge bg-soft-success text-success rounded-pill px-2 py-1" style="font-size: 0.7rem;">Actif</span>
                            </div>

                            <a href="{{ path('thread_show', {'id': thread.id}) }}" class="text-decoration-none">
                                <h4 class="fw-bold text-dark mb-3 hover-text-success transition-all">{{ thread.title }}</h4>
                            </a>

                            <p class="text-muted mb-4 line-clamp-2" style="font-size: 0.95rem;">
                                {{ thread.content|slice(0, 100) }}...
                            </p>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <div class="thread-user-info">
                                    <div class="avatar-initial">{{ thread.authorName|first|upper }}</div>
                                    <div>
                                        <div class="fw-bold text-dark">{{ thread.authorName }}</div>
                                        <div class="small opacity-75">{{ thread.createdAt|date('d M Y') }}</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 text-muted small fw-bold">
                                    <span><i class="bi bi-chat-text me-1"></i> {{ thread.responses|length }}</span>
                                    <span><i class="bi bi-heart me-1"></i> {{ thread.likeCount }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <div class="display-1 text-muted opacity-25 mb-4"><i class="bi bi-chat-dots"></i></div>
                        <h3>Aucune discussion trouvée</h3>
                        <p class="text-muted">Commencez la conversation dès maintenant !</p>
                        <a href="{{ path('thread_new') }}" class="btn btn-agri mt-3 px-5">Lancer un sujet</a>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Sidebar #}
        <div class="col-lg-3">
            <div class="sidebar-card">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Membres Actifs</h5>
                {% for info in [{'n':'Vous','c':'#1B4332'},{'n':'Ali','c':'#FF5722'},{'n':'Sofi','c':'#4CAF50'},{'n':'Rami','c':'#2196F3'},{'n':'Mona','c':'#E91E63'}] %}
                    <div class="member-item">
                        <div class="position-relative">
                            <div class="avatar-initial" style="background: {{ info.c }}; width: 40px; height: 40px;">
                                {{ info.n|first|upper }}
                            </div>
                            <div class="status-dot position-absolute bottom-0 end-0"></div>
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">{{ info.n }}</div>
                            <div class="text-success small" style="font-size: 0.7rem;">En ligne</div>
                        </div>
                    </div>
                {% endfor %}

                <div class="mt-5 p-4 bg-light rounded-4 text-center">
                    <i class="bi bi-patch-question fs-1 text-success mb-2 d-block"></i>
                    <p class="small text-muted mb-3">Besoin d'aide ou d'un conseil spécifique ?</p>
                    <a href="{{ path('thread_new') }}" class="btn btn-link text-success p-0 fw-bold text-decoration-none small">Poser une question</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-text-success:hover { color: var(--agri-secondary) !important; }
    .transition-all { transition: all 0.3s ease; }
    .bg-soft-success { background: #e8f5e9; }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
{% endblock %}

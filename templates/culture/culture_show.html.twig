{% extends 'agriculteur.html.twig' %}

{% block title %}Détail Culture — {{ culture.nom }}{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center g-4">

            {# ── Fiche culture ── #}
            <div class="col-lg-6">
                <div class="card shadow border-0" style="border-radius: 15px;">
                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(to right, #4a7c3a, #66bb6a); border-radius: 15px 15px 0 0;">
                        <h3>🌱 {{ culture.nom }}</h3>
                        <small class="opacity-75">Fiche culture détaillée</small>
                    </div>

                    <div class="card-body p-5">
                        <table class="table table-bordered">
                            <tr>
                                <th style="color: #4a7c3a;">🌿 Nom</th>
                                <td>{{ culture.nom }}</td>
                            </tr>
                            <tr>
                                <th style="color: #4a7c3a;">📂 Type</th>
                                <td>
                                    <span class="badge" style="background-color: #66bb6a;">{{ culture.type }}</span>
                                </td>
                            </tr>
                            <tr>
                                <th style="color: #4a7c3a;">📐 Superficie</th>
                                <td>{{ culture.superficie }} ha</td>
                            </tr>
                            <tr>
                                <th style="color: #4a7c3a;">📍 Localisation</th>
                                <td>{{ culture.localisation }}</td>
                            </tr>
                            {% if culture.diagnostics is defined and culture.diagnostics|length > 0 %}
                            <tr>
                                <th style="color: #4a7c3a;">🩺 Diagnostics</th>
                                <td>
                                    <span class="badge bg-warning text-dark">{{ culture.diagnostics|length }} diagnostic(s)</span>
                                </td>
                            </tr>
                            {% endif %}
                        </table>

                        <div class="d-flex gap-2 mt-3 flex-wrap">
                            <a href="{{ path('app_culture_edit', {'id': culture.idCulture}) }}"
                               class="btn btn-warning flex-grow-1">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <a href="{{ path('app_culture_index') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Widget Météo (OpenWeatherMap API) ── #}
            <div class="col-lg-4">
                {% if meteo is not null %}
                <div class="card shadow border-0 h-100" style="border-radius: 15px; background: linear-gradient(135deg, #1a73e8, #0d47a1); color: white;">
                    <div class="card-body p-4 text-center">
                        <h5 class="mb-1 opacity-75" style="font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">🌤️ Météo en direct</h5>
                        <h4 class="mb-0 mt-2">{{ meteo.ville }}{% if meteo.pays %}, {{ meteo.pays }}{% endif %}</h4>

                        <div class="my-3">
                            <img src="https://openweathermap.org/img/wn/{{ meteo.icone }}@2x.png"
                                 alt="{{ meteo.description }}" style="width: 80px; height: 80px;">
                        </div>

                        <div style="font-size: 52px; font-weight: 700; line-height: 1;">
                            {{ meteo.temperature }}°C
                        </div>
                        <div class="mt-1 opacity-85" style="font-size: 16px;">{{ meteo.description }}</div>

                        <div class="row mt-4 text-center g-2">
                            <div class="col-4">
                                <div style="background: rgba(255,255,255,0.15); border-radius: 10px; padding: 8px;">
                                    <div style="font-size: 18px;">💧</div>
                                    <div style="font-size: 13px; font-weight:600;">{{ meteo.humidite }}%</div>
                                    <div style="font-size: 10px; opacity: 0.75;">Humidité</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div style="background: rgba(255,255,255,0.15); border-radius: 10px; padding: 8px;">
                                    <div style="font-size: 18px;">🌡️</div>
                                    <div style="font-size: 13px; font-weight:600;">{{ meteo.ressenti }}°C</div>
                                    <div style="font-size: 10px; opacity: 0.75;">Ressenti</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div style="background: rgba(255,255,255,0.15); border-radius: 10px; padding: 8px;">
                                    <div style="font-size: 18px;">💨</div>
                                    <div style="font-size: 13px; font-weight:600;">{{ meteo.vent }} km/h</div>
                                    <div style="font-size: 10px; opacity: 0.75;">Vent</div>
                                </div>
                            </div>
                        </div>

                        <p class="mt-3 mb-0" style="font-size: 10px; opacity: 0.6;">
                            Données : OpenWeatherMap API
                        </p>
                    </div>
                </div>

                {% else %}
                {# Affichage si clé API non configurée ou erreur #}
                <div class="card shadow border-0 h-100" style="border-radius: 15px; background: #f8f9fa;">
                    <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                        <div style="font-size: 48px; color: #aaa;">🌤️</div>
                        <h5 class="mt-2 mb-1" style="color: #555;">Météo non disponible</h5>
                        <p class="text-muted small mb-3">
                            Configurez votre clé API OpenWeatherMap dans le fichier <code>.env</code>
                            pour afficher la météo en direct.
                        </p>
                        <code class="small text-secondary">OPENWEATHER_API_KEY=votre_clé</code>
                    </div>
                </div>
                {% endif %}
            </div>

        </div>
    </div>
</section>
{% endblock %}

{% extends 'agriculteur.html.twig' %}

{% block title %}Nouvel Événement - AgriConnect{% endblock %}

{% block body %}
<div class="premium-header">
    <div class="container text-center">
        <h1 class="premium-title">Créer un Événement</h1>
        <p class="premium-subtitle">Organisez des rencontres et des formations pour la communauté.</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-premium-card shadow-lg border-0">
                <div class="mb-4 pb-3 border-bottom d-flex align-items-center gap-3">
                    <div class="bg-soft-agri p-3 rounded-circle">
                        <i class="bi bi-calendar-plus fs-3 text-agri"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Informations de l'événement</h4>
                        <p class="text-muted small mb-0">Remplissez les détails ci-dessous.</p>
                    </div>
                </div>

                {{ include('evenement/_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

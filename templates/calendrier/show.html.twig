{% extends 'agriculteur.html.twig' %}

{% block title %}Détails de l'Activité{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow border-0" style="border-radius: 18px; overflow: hidden;">
                    <div class="card-header text-white py-4" 
                         style="background: {{ activity.isConfirmed ? 'linear-gradient(135deg, #2d6a2d 0%, #4a7c3a 100%)' : 'linear-gradient(135deg, #455a64 0%, #607d8b 100%)' }}">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">{{ activity.title }}</h3>
                            <span class="badge {{ activity.isConfirmed ? 'bg-success' : 'bg-warning text-dark' }}">
                                {{ activity.isConfirmed ? 'Confirmé' : 'Suggestion IA' }}
                            </span>
                        </div>
                    </div>
                    
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <label class="text-muted small text-uppercase fw-bold">Type d'activité</label>
                            <div class="fs-5 fw-bold">{{ activity.type }}</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <label class="text-muted small text-uppercase fw-bold">Début</label>
                                <div>{{ activity.beginAt|date('d/m/Y H:i') }}</div>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small text-uppercase fw-bold">Fin</label>
                                <div>{{ activity.endAt ? activity.endAt|date('d/m/Y H:i') : '—' }}</div>
                            </div>
                        </div>

                        {% if activity.culture %}
                        <div class="mb-4 p-3 bg-light rounded-3">
                            <label class="text-muted small text-uppercase fw-bold">Culture liée</label>
                            <div class="fw-bold">{{ activity.culture.nom }} ({{ activity.culture.type }})</div>
                        </div>
                        {% endif %}

                        <div class="mb-5">
                            <label class="text-muted small text-uppercase fw-bold">Description / Conseil IA</label>
                            <p class="mt-1">{{ activity.description|default('Aucune description.') }}</p>
                        </div>

                        <div class="d-grid gap-2">
                            {% if not activity.isConfirmed %}
                                <form action="{{ path('app_calendrier_confirm', {id: activity.id}) }}" method="POST">
                                    <button type="submit" class="btn btn-success w-100 py-3 fw-bold">
                                        ✅ Valider cette suggestion
                                    </button>
                                </form>
                            {% endif %}

                            <form action="{{ path('app_calendrier_delete', {id: activity.id}) }}" method="POST" onsubmit="return confirm('Supprimer cette activité ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activity.id) }}">
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    {{ activity.isConfirmed ? 'Supprimer' : 'Ignorer la suggestion' }}
                                </button>
                            </form>
                            
                            <a href="{{ path('app_calendrier_index') }}" class="btn btn-link text-secondary">Retour au calendrier</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

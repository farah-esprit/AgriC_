<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #2c3e50; background: #fff; }

  .header { background: linear-gradient(135deg, #2d6a4f, #52b788); color: white; padding: 25px 30px; margin-bottom: 25px; }
  .header h1 { font-size: 22px; margin-bottom: 5px; }
  .header .meta { font-size: 10px; opacity: 0.85; }

  .logo-line { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .logo-icon { font-size: 28px; }

  .section { margin: 0 30px 20px; }
  .section-title { font-size: 13px; font-weight: bold; color: #2d6a4f; border-bottom: 2px solid #52b788; padding-bottom: 5px; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px; }

  table { width: 100%; border-collapse: collapse; }
  th { background: #f0f7f4; color: #2d6a4f; text-align: left; padding: 8px 10px; font-size: 11px; border: 1px solid #d4edda; width: 35%; }
  td { padding: 8px 10px; border: 1px solid #d4edda; font-size: 11px; line-height: 1.5; }
  tr:nth-child(even) td { background: #fafffe; }

  .badge { display: inline-block; background: #52b788; color: white; padding: 2px 8px; border-radius: 10px; font-size: 10px; }
  .badge-urgence-faible   { background: #52b788; }
  .badge-urgence-moderee  { background: #e9a317; color: white; }
  .badge-urgence-elevee   { background: #e74c3c; }

  .footer { position: fixed; bottom: 0; left: 0; right: 0; background: #f0f7f4; border-top: 1px solid #d4edda; padding: 8px 30px; font-size: 9px; color: #888; display: flex; justify-content: space-between; }

  .symptomes-box { background: #f9f9f9; border-left: 4px solid #52b788; padding: 10px 14px; border-radius: 4px; font-size: 11px; line-height: 1.6; margin-bottom: 5px; }
  .infos-box { background: #fffde7; border-left: 4px solid #f9a825; padding: 10px 14px; border-radius: 4px; font-size: 11px; line-height: 1.6; }
</style>
</head>
<body>

<div class="header">
  <div class="logo-line">
    <span class="logo-icon">🌿</span>
    <div>
      <h1>Fiche de Diagnostic Agricole</h1>
      <div class="meta">AgriConnect — Généré le {{ date|date('d/m/Y à H:i') }}</div>
    </div>
  </div>
</div>

<div class="section">
  <div class="section-title">Informations du diagnostic</div>
  <table>
    <tr>
      <th>Numéro de diagnostic</th>
      <td><strong>#{{ diagnostic.idDiagnostic }}</strong></td>
    </tr>
    <tr>
      <th>Date du diagnostic</th>
      <td>{{ diagnostic.dateDiagnostic }}</td>
    </tr>
    <tr>
      <th>Culture concernée</th>
      <td>
        {% if diagnostic.culture %}
          <span class="badge">{{ diagnostic.culture.nom }}</span>
          — Type : {{ diagnostic.culture.type }}
          — Superficie : {{ diagnostic.culture.superficie }} ha
          — Localisation : {{ diagnostic.culture.localisation }}
        {% else %}
          Non renseignée
        {% endif %}
      </td>
    </tr>
  </table>
</div>

<div class="section">
  <div class="section-title">Symptômes observés</div>
  <div class="symptomes-box">
    {{ diagnostic.symptomes|nl2br }}
  </div>
</div>

{% if diagnostic.informationsComplementaires %}
<div class="section">
  <div class="section-title">Informations complémentaires</div>
  <div class="infos-box">
    {{ diagnostic.informationsComplementaires|nl2br }}
  </div>
</div>
{% endif %}

<div class="footer">
  <span>AgriConnect — Application de gestion agricole — Diagnostic IA Local</span>
  <span>Diagnostic #{{ diagnostic.idDiagnostic }} — {{ date|date('d/m/Y') }}</span>
</div>

</body>
</html>

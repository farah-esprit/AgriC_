{% extends 'base.html.twig' %}

{% block title %}Accueil - AgriConnect Forum{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forum.css') }}">
{% endblock %}

{% block body %}
<div class="container py-4" style="margin-top: 30px;">
    <div class="row g-4">
        <!-- Sidebar Gauche Dynamique -->
        <div class="col-lg-3">
            <div class="cinematic-sidebar-container" style="position: -webkit-sticky; position: sticky; top: 90px; z-index: 100; max-height: calc(100vh - 110px); overflow-y: auto; scrollbar-width: none; -ms-overflow-style: none; padding: 2px;">
                <style>
                    /* Premium Cinematic Sidebar Styles */
                    .cinematic-sidebar-container::-webkit-scrollbar { display: none; }
                    
                    .glass-card {
                        background: rgba(255, 255, 255, 0.9);
                        backdrop-filter: blur(10px);
                        -webkit-backdrop-filter: blur(10px);
                        border: 1px solid rgba(255, 255, 255, 0.4);
                        border-radius: 20px;
                        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
                        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
                        margin-bottom: 20px;
                        overflow: hidden;
                    }
                    
                    .glass-card:hover {
                        transform: translateY(-5px);
                        box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.12);
                        border-color: rgba(var(--primary-color-rgb), 0.3);
                    }

                    .stat-badge {
                        background: rgba(var(--primary-color-rgb), 0.1);
                        color: var(--primary-color);
                        padding: 4px 10px;
                        border-radius: 12px;
                        font-weight: 700;
                        font-size: 0.75rem;
                    }

                    .trending-item-cinematic {
                        padding: 12px;
                        border-radius: 14px;
                        transition: all 0.3s ease;
                        border-bottom: 1px solid #f0f4f8;
                        cursor: pointer;
                    }

                    .trending-item-cinematic:hover {
                        background: rgba(var(--primary-color-rgb), 0.05);
                        padding-left: 18px;
                    }

                    .trending-item-cinematic:last-child { border-bottom: none; }

                    .trending-title-cinematic {
                        font-size: 0.9rem;
                        font-weight: 800;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        color: #1e293b;
                        display: flex;
                        align-items: center;
                        gap: 10px;
                        margin-bottom: 15px;
                    }

                    .animated-pulse {
                        animation: heart-pulse 2s infinite;
                    }

                    @keyframes heart-pulse {
                        0% { transform: scale(1); }
                        50% { transform: scale(1.1); }
                        100% { transform: scale(1); }
                    }

                    .quick-action-btn {
                        transition: all 0.3s ease;
                        border-radius: 12px !important;
                        text-align: left;
                        padding: 12px 15px !important;
                        font-weight: 600 !important;
                        border: none !important;
                        background: #f8fafc !important;
                        color: #475569 !important;
                        margin-bottom: 8px;
                    }

                    .quick-action-btn:hover {
                        background: var(--primary-color) !important;
                        color: white !important;
                        transform: translateX(5px);
                    }
                </style>
                
                <!-- 📊 USER PROGRESS CARD -->
                {% if app.user %}
                    {% set user_xp = app.user.xp|default(0) %}
                    {% set user_strikes = app.user.strikes|default(0) %}
                    {% set rank_name = "Novice" %}
                    {% set next_level_xp = 50 %}
                    {% if user_xp > 300 %}{% set rank_name = "Master" %}{% set next_level_xp = 1000 %}
                    {% elseif user_xp > 150 %}{% set rank_name = "Expert" %}{% set next_level_xp = 300 %}
                    {% elseif user_xp >= 10 %}{% set rank_name = "Fermier" %}{% set next_level_xp = 150 %}
                    {% endif %}
                    {% set xp_progress = (user_xp / next_level_xp * 100)|round %}

                    <div class="glass-card" style="background: linear-gradient(135deg, #166534, #15803d); color: white;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div style="background: rgba(255,255,255,0.2); width: 50px; height: 50px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem;">
                                        <i class="bi bi-person-badge"></i>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8;">Statut Actuel</div>
                                        <div style="font-size: 1.3rem; font-weight: 800;">{{ rank_name }}</div>
                                    </div>
                                </div>
                                <div class="animated-pulse" style="font-size: 1.5rem; opacity: 0.5;"><i class="bi bi-shield-check"></i></div>
                            </div>

                            <div class="xp-container mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.85rem; font-weight: 600;">
                                    <span>Niveau {{ ((user_xp / 100)|round(0, 'floor')) + 1 }}</span>
                                    <span>{{ user_xp }} XP</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 20px; background: rgba(0,0,0,0.15);">
                                    <div class="progress-bar bg-white shadow-sm" style="width: {{ xp_progress }}%; border-radius: 20px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- 🌦️ WEATHER WIDGET -->
                <div class="glass-card">
                    <div class="card-body p-4" style="background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="trending-title-cinematic mb-0"><i class="bi bi-cloud-sun text-primary"></i> Météo</div>
                            <span style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; background: #e2e8f0; padding: 2px 8px; border-radius: 10px;">Tunis</span>
                        </div>
                        <div class="d-flex align-items-center gap-4">
                            <div style="font-size: 2.8rem; color: #f59e0b;"><i class="bi bi-brightness-high"></i></div>
                            <div>
                                <div style="font-size: 2rem; font-weight: 900; color: #0f172a; line-height: 1;">24°</div>
                                <div style="font-size: 0.85rem; color: #64748b; font-weight: 600;">Ciel dégagé</div>
                            </div>
                        </div>
                        <div class="mt-4 p-3 rounded-4" style="background: white; border: 1px solid #e2e8f0;">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-lightning-charge-fill text-warning"></i>
                                <span style="font-size: 0.7rem; font-weight: 800; color: #475569;">CONSEIL IA</span>
                            </div>
                            <div style="font-size: 0.8rem; color: #334155; line-height: 1.4;">Vent optimal (12km/h) pour le traitement des oliviers cet après-midi.</div>
                        </div>
                    </div>
                </div>

                <!-- ⚡ QUICK ACTIONS -->
                <div class="glass-card">
                    <div class="card-body p-4">
                        <div class="trending-title-cinematic"><i class="bi bi-lightning-fill text-warning"></i> Navigation</div>
                        <div class="d-flex flex-column">
                            <a href="{{ path('thread_index') }}" class="quick-action-btn d-flex align-items-center gap-3">
                                <i class="bi bi-grid-1x2"></i> Flux Global
                            </a>
                            {% if not app.user %}
                                <a href="{{ path('app_signup') }}" class="quick-action-btn d-flex align-items-center gap-3" style="background: rgba(var(--primary-color-rgb), 0.05) !important; color: var(--primary-color) !important;">
                                    <i class="bi bi-person-plus"></i> Rejoindre la ferme
                                </a>
                            {% else %}
                                <a href="{{ path('thread_new') }}" class="quick-action-btn d-flex align-items-center gap-3" style="background: rgba(34, 197, 94, 0.1) !important; color: #166534 !important;">
                                    <i class="bi bi-plus-circle"></i> Publier un sujet
                                </a>
                                <a href="{{ path('app_profile') }}" class="quick-action-btn d-flex align-items-center gap-3">
                                    <i class="bi bi-person-circle"></i> Mon Profil
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- ❤️ TRENDING LIKED -->
                <div class="glass-card">
                    <div class="card-body p-4">
                        <div class="trending-title-cinematic"><i class="bi bi-heart-fill text-danger"></i> Tendances</div>
                        {% for t in mostLikedThreads %}
                            <div class="trending-item-cinematic" onclick="window.location.href='{{ path('thread_show', {id: t.id}) }}'">
                                <div style="font-size: 0.9rem; font-weight: 700; color: #1e293b; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ t.title }}</div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span style="font-size: 0.75rem; color: #64748b;"><i class="bi bi-person me-1"></i>{{ t.authorName }}</span>
                                    <span class="stat-badge"><i class="bi bi-fire me-1"></i>{{ t.likeCount }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

    <!-- Main Content -->
    <div class="col-lg-9">

            {% if app.user %}
            <!-- User Welcome Banner -->
            <div class="user-welcome-banner mb-4">
                <div class="welcome-content">
                    <h2>👋 Bonjour, {{ app.user.nom ?: 'Utilisateur' }} !</h2>
                    <div class="user-details">
                        <span class="user-role-badge">{{ app.user.role ?: 'Membre' }}</span>
                        {% if app.user.etatCompte %}
                            <span class="user-status-badge status-{{ app.user.etatCompte|lower }}">{{ app.user.etatCompte }}</span>
                        {% endif %}
                    </div>
                    <p class="welcome-message">Bienvenue sur votre espace de discussion agricole. Participez aux conversations et partagez vos connaissances !</p>
                </div>
            </div>
            {% endif %}

            <!-- Stories Bar -->
    {% include 'story/_stories_bar.html.twig' %}

    <!-- Navigation -->
            <div class="nav mb-4">
                <div class="nav-links">
                    <a href="{{ path('thread_index') }}">Accueil</a>
                    <a href="{{ path('thread_new') }}">Nouveau sujet</a>
                    {% if app.user %}
                        <div class="user-info">
                            <span class="user-name">👤 {{ app.user.nom ?: 'Utilisateur' }}</span>
                            {% if app.user.role %}
                                <span class="user-role">({{ app.user.role }})</span>
                            {% endif %}
                            {% if app.user.etatCompte %}
                                <span class="user-status status-{{ app.user.etatCompte|lower }}">{{ app.user.etatCompte }}</span>
                            {% endif %}
                        </div>
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_signin') }}">Connexion</a>
                    {% endif %}
                </div>
            </div>

            <!-- Search and Filter Section -->
            <div class="search-section mb-4">
                <div class="card p-4">
                    <h2 class="mb-3">🔍 Rechercher des sujets</h2>
                    <form method="GET" action="{{ path('thread_index') }}" class="search-form">
                        <div class="search-fields row g-3">
                            <div class="search-field col-md-6">
                                <label for="search" class="form-label">Titre du sujet :</label>
                                <input type="text" id="search" name="search" value="{{ searchTerm }}"
                                       placeholder="Entrez le titre..." class="form-control">
                            </div>

                            <div class="search-field col-md-6">
                                <label for="category" class="form-label">Catégorie :</label>
                                <select id="category" name="category" class="form-control">
                                    <option value="">Toutes les catégories</option>
                                    {% for cat in categories %}
                                        <option value="{{ cat }}" {% if cat == selectedCategory %}selected{% endif %}>{{ cat }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="search-actions mt-3">
                            <button type="submit" class="btn btn-primary d-inline-flex mx-1"><i class="bi bi-search me-1"></i> Rechercher</button>
                            <a href="{{ path('thread_index') }}" class="btn btn-secondary d-inline-flex mx-1">Effacer les filtres</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Welcome Section -->
            <div class="welcome-section mb-4">
                <div class="card p-4">
                    <h2>🌱 Discussions Agricoles</h2>
                    <p>Découvrez les derniers sujets de discussion, partagez vos expériences et connectez-vous avec la communauté agricole.</p>
                    {% if not app.user %}
                        <div class="cta-buttons mt-3">
                            <a href="{{ path('app_signin') }}" class="btn btn-primary me-2">Se connecter</a>
                            <a href="{{ path('thread_new') }}" class="btn btn-secondary">Créer un sujet</a>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Threads with Responses -->
            <div class="threads-with-responses">
                <h2 style="color: var(--heading-color); margin-bottom: 30px; text-align: center;">Derniers sujets de discussion</h2>

                {% for thread in threads %}
                <div class="thread-with-responses-card mb-4">
                    <!-- Thread Header -->
                    <div class="thread-header">
                        <div class="thread-main-info">
                            <h3 class="thread-title">
                                <a href="{{ path('thread_show', {'id': thread.id}) }}">{{ thread.title }}</a>
                            </h3>
                            <div class="thread-meta">
                                <span class="author" style="display: flex; align-items: center; gap: 8px;">
                                    {% if thread.user %}
                                        {% if thread.user.profile and thread.user.profile.image %}
                                            <img src="{{ asset('uploads/profils/' ~ thread.user.profile.image) }}" alt="Avatar" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;">
                                        {% else %}
                                            <span class="user-avatar-small" style="width: 24px; height: 24px; background-color: #3b824d; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 10px;">
                                                {{ thread.user.nom|first|upper }}
                                            </span>
                                        {% endif %}
                                        <a href="{{ path('app_profile_show', {'id': thread.user.userId}) }}" style="color: inherit; font-weight: 600;">{{ thread.user.nom }}</a>
                                    {% else %}
                                        👤 Utilisateur inconnu
                                    {% endif %}
                                </span>
                                <span class="date">{{ thread.createdAt ? thread.createdAt|date('d/m/Y H:i') : 'Date inconnue' }}</span>
                                {% if thread.category %}
                                    <span class="category">{{ thread.category }}</span>
                                {% endif %}
                                {% if thread.status %}
                                    <span class="status-badge status-{{ thread.status|lower }}">{{ thread.status }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="thread-stats">
                            <span class="likes">❤️ {{ thread.likeCount ?: 0 }}</span>
                            <span class="responses-count">💬 {{ thread.responses|length }} réponse(s)</span>
                        </div>
                    </div>

                    <!-- Thread Content -->
                    <div class="thread-content content-with-sidebar">
                        <div class="action-sidebar">
                            {% if app.user %}
                                {% set threadLiked = thread.id in likedThreadIds %}
                                <form method="post" action="{{ path('thread_like', {'id': thread.id}) }}" style="margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('like' ~ thread.id) }}">
                                    <button type="submit" class="sidebar-button success" title="{{ threadLiked ? 'Retirer le like' : 'Aimer ce sujet' }}">
                                        {{ threadLiked ? '💔' : '❤️' }}
                                    </button>
                                </form>
                            {% endif %}
                            
                            {% if app.user %}
                                <button type="button" class="sidebar-button info" id="share-btn-{{ thread.id }}" onclick="shareThread({{ thread.id }})" title="Partager sur mon profil" style="background-color: var(--secondary-color); color: white; border: none; font-size: 1.1rem; padding: 6px; border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-bottom: 5px; cursor: pointer;">
                                    📢
                                </button>
                                
                                {% if thread.user and app.user.userId == thread.user.userId %}
                                    <a href="{{ path('thread_edit', {'id': thread.id}) }}" class="sidebar-button secondary small" title="Modifier le sujet">
                                        ✏️
                                    </a>
                                    <form method="post" action="{{ path('thread_delete', {'id': thread.id}) }}" style="margin: 0;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce sujet ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ thread.id) }}">
                                        <button type="submit" class="sidebar-button danger small" title="Supprimer le sujet">
                                            🗑️
                                        </button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </div>
                        
                        <p>{{ thread.content|slice(0, 200) }}{% if thread.content|length > 200 %}...{% endif %}</p>
                    </div>

                    <!-- Thread Attachments -->
                    {% if thread.attachments %}
                    <div class="thread-attachments">
                        <strong>📎 Pièces jointes :</strong>
                        <div class="attachments-preview">
                            {% for filename in thread.attachments|split(',') %}
                                {% set extension = filename|split('.')|last|lower %}
                                {% if extension in ['jpg', 'jpeg', 'png', 'gif', 'webp'] %}
                                    <div class="attachment-item image-attachment">
                                        <img src="{{ asset('uploads/' ~ filename) }}" alt="Image" class="attachment-image">
                                    </div>
                                {% elseif extension in ['mp4', 'webm', 'ogg'] %}
                                    <div class="attachment-item video-attachment">
                                        <video controls class="attachment-video">
                                            <source src="{{ asset('uploads/' ~ filename) }}" type="video/{{ extension }}">
                                            Votre navigateur ne supporte pas la lecture vidéo.
                                        </video>
                                    </div>
                                {% else %}
                                    <div class="attachment-item file-attachment">
                                        <a href="{{ asset('uploads/' ~ filename) }}" target="_blank" class="attachment-link">
                                            📄 {{ filename }}
                                        </a>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    <!-- All Responses for Thread -->
                    {% if thread.responses|length > 0 %}
                    <div class="responses-section">
                        <h4>Toutes les réponses ({{ thread.responses|length }}) :</h4>
                        <div class="responses-list">
                            {% for response in thread.responses %}
                            <div class="response-item">
                                <div class="response-header">
                                    <div class="response-author">
                                        {% if response.user %}
                                            <a href="{{ path('app_profile_show', {'id': response.user.userId}) }}" style="color: inherit; text-decoration: none;"><strong>{{ response.user.nom }}</strong></a>
                                        {% else %}
                                            <strong>Utilisateur inconnu</strong>
                                        {% endif %}
                                    </div>
                                    <div class="response-meta">
                                        <span class="response-date">{{ response.createdAt ? response.createdAt|date('d/m/Y H:i') : '' }}</span>
                                        {% if response.likeCount %}
                                            <span class="response-likes">❤️ {{ response.likeCount }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="response-content content-with-sidebar">
                                    <div class="action-sidebar">
                                        {% if app.user %}
                                            <form method="post" action="{{ path('response_like', {'id': response.id}) }}" style="margin: 0;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('like_response' ~ response.id) }}">
                                                <button type="submit" class="sidebar-button success small" title="Aimer cette réponse">
                                                    ❤️
                                                </button>
                                            </form>
                                            
                                            {% if response.user and app.user.userId == response.user.userId %}
                                                <a href="{{ path('response_edit', {'id': response.id}) }}" class="sidebar-button secondary small" title="Modifier la réponse">
                                                    ✏️
                                                </a>
                                                <form method="post" action="{{ path('response_delete', {'id': response.id}) }}" style="margin: 0;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réponse ?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_response' ~ response.id) }}">
                                                    <button type="submit" class="sidebar-button danger small" title="Supprimer la réponse">
                                                        🗑️
                                                    </button>
                                                </form>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                    
                                    {{ response.content|nl2br }}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    <!-- Thread Actions -->
                    <div class="thread-actions mt-3">
                        <a href="{{ path('thread_show', {'id': thread.id}) }}" class="btn btn-primary">Voir le sujet complet</a>
                        {% if app.user %}
                        <form method="post" action="{{ path('thread_like', {'id': thread.id}) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('like' ~ thread.id) }}">
                            <button type="submit" class="btn btn-success">Aimer</button>
                        </form>
                        {% endif %}
                    </div>
                </div>
                {% else %}
                <div class="empty-state">
                    <div class="card p-5 text-center">
                        <div class="card-content">
                            <h2>🎯 Aucun sujet pour le moment</h2>
                            <p class="text-muted">Soyez le premier à lancer une discussion sur notre forum agricole !</p>
                            <a href="{{ path('thread_new') }}" class="btn btn-primary mt-3">Créer le premier sujet</a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    function shareThread(id) {
        const btn = document.getElementById('share-btn-' + id);
        btn.innerHTML = '⌛';
        
        fetch(`/thread/${id}/share`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    btn.innerHTML = data.shared ? '✅' : '📢';
                    alert(data.message);
                } else {
                    btn.innerHTML = '📢';
                    alert(data.message || 'Erreur lors du partage.');
                }
            })
            .catch(err => {
                console.error(err);
                btn.innerHTML = '📢';
            });
    }
</script>
{% endblock %}
{% extends 'agriculteur.html.twig' %}

{% block title %}Liste des Cultures{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 style="color: #4a7c3a; font-weight: bold;">🌱 Gestion des Cultures</h2>
            <div class="d-flex gap-2">
                <a href="{{ path('app_culture_analyze_image') }}" class="btn btn-outline-success">
                    <i class="bi bi-camera"></i> Analyser Image
                </a>
                <a href="{{ path('app_culture_new') }}" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Ajouter une culture
                </a>
            </div>
        </div>

        {# ── BANDEAU MÉTÉO PREMIUM ── #}
        <div class="mb-5">
            {% if meteo is not null %}
            <div class="card shadow border-0 overflow-hidden" 
                 style="border-radius: 20px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
                <div class="card-body p-0">
                    <div class="row g-0 align-items-center">
                        {# Colonne Gauche : Ville et Sélecteur #}
                        <div class="col-md-5 p-4 border-end border-white border-opacity-10">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="bg-white bg-opacity-20 p-2 rounded-3">
                                    <i class="bi bi-geo-alt-fill fs-4"></i>
                                </div>
                                <div>
                                    <h4 class="mb-0 fw-bold">{{ meteo.ville }}</h4>
                                    <small class="opacity-75">Ma région agricole</small>
                                </div>
                            </div>
                            
                            <form action="{{ path('app_culture_index') }}" method="get" id="weatherForm">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-10 border-white border-opacity-25 text-white">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <select name="ville" class="form-select bg-white bg-opacity-10 border-white border-opacity-25 text-white" 
                                            style="cursor: pointer;" onchange="document.getElementById('weatherForm').submit()">
                                        <option value="" style="color: black;">Changer de région...</option>
                                        {% for region in ['Tunis', 'Sousse', 'Sfax', 'Nabeul', 'Bizerte', 'Kairouan', 'Béja', 'Jendouba', 'Gafsa', 'Gabès', 'Monastir'] %}
                                            <option value="{{ region }}" {{ villeMeteo == region ? 'selected' : '' }} style="color: black;">{{ region }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                {# Garder les autres filtres si présents #}
                                {% if search %}<input type="hidden" name="search" value="{{ search }}">{% endif %}
                                {% if filterType %}<input type="hidden" name="type" value="{{ filterType }}">{% endif %}
                            </form>
                        </div>

                        {# Colonne Centre : Température et Icône #}
                        <div class="col-md-4 p-4 text-center border-end border-white border-opacity-10">
                            <div class="d-flex align-items-center justify-content-center gap-4">
                                <img src="https://openweathermap.org/img/wn/{{ meteo.icone }}@2x.png" 
                                     alt="{{ meteo.description }}" style="width: 70px;">
                                <div class="text-start">
                                    <div style="font-size: 3rem; font-weight: 800; line-height: 1;">{{ meteo.temperature }}°C</div>
                                    <div class="text-capitalize opacity-90">{{ meteo.description }}</div>
                                </div>
                            </div>
                        </div>

                        {# Colonne Droite : Détails #}
                        <div class="col-md-3 p-4">
                            <div class="d-flex flex-column gap-2" style="font-size: 0.9rem;">
                                <div class="d-flex justify-content-between">
                                    <span class="opacity-75">💧 Humidité</span>
                                    <span class="fw-bold">{{ meteo.humidite }}%</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="opacity-75">🌡️ Ressenti</span>
                                    <span class="fw-bold">{{ meteo.ressenti }}°C</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="opacity-75">💨 Vent</span>
                                    <span class="fw-bold">{{ meteo.vent }} km/h</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="alert alert-info border-0 shadow-sm" style="border-radius: 15px;">
                <i class="bi bi-info-circle me-2"></i> Configurez votre clé API OpenWeatherMap pour afficher la météo en direct.
            </div>
            {% endif %}
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# ── STATISTIQUES ── #}
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card text-white text-center shadow border-0" style="border-radius:12px; background: linear-gradient(to right,#4a7c3a,#66bb6a);">
                    <div class="card-body py-3">
                        <div style="font-size:2rem; font-weight:bold;">{{ stats.total }}</div>
                        <div>Total Cultures</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-white text-center shadow border-0" style="border-radius:12px; background: linear-gradient(to right,#1565c0,#42a5f5);">
                    <div class="card-body py-3">
                        <div style="font-size:2rem; font-weight:bold;">{{ stats.totaleHa is defined ? stats.totaleHa : 0 }} ha</div>
                        <div>Superficie Totale</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-white text-center shadow border-0" style="border-radius:12px; background: linear-gradient(to right,#e65100,#ffa726);">
                    <div class="card-body py-3">
                        <div style="font-size:2rem; font-weight:bold;">{{ stats.moyenne is defined ? stats.moyenne : 0 }} ha</div>
                        <div>Superficie Moyenne</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-white text-center shadow border-0" style="border-radius:12px; background: linear-gradient(to right,#6a1b9a,#ab47bc);">
                    <div class="card-body py-3">
                        <div style="font-size:2rem; font-weight:bold;">{{ stats.max is defined ? stats.max : 0 }} ha</div>
                        <div>Superficie Max</div>
                    </div>
                </div>
            </div>
        </div>

        {# ── RECHERCHE ET FILTRES ── #}
        <div class="card shadow border-0 mb-4" style="border-radius:15px;">
            <div class="card-body p-4">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">🔍 Recherche</label>
                        <input type="text" name="search" class="form-control"
                               placeholder="Nom, type, localisation..."
                               value="{{ search is defined and search ? search : '' }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">📂 Filtrer par type</label>
                        <select name="type" class="form-select">
                            <option value="">-- Tous les types --</option>
                            {% for option in ['Céréales','Légumes','Fruits','Oléagineux','Fourragères','Autre'] %}
                                <option value="{{ option }}" {{ (filterType is defined and filterType == option) ? 'selected' : '' }}>{{ option }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">📐 Trier par superficie</label>
                        <select name="sort" class="form-select">
                            <option value="">-- Trier --</option>
                            <option value="DESC">Plus grande d'abord</option>
                            <option value="ASC">Plus petite d'abord</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-grow-1">Filtrer</button>
                        <a href="{{ path('app_culture_index') }}" class="btn btn-outline-secondary">✕</a>
                    </div>
                </form>
            </div>
        </div>

        {# ── CARTES CULTURES ── #}
        {% if cultures.getTotalItemCount() == 0 %}
            <div class="text-center py-5">
                <p class="text-muted fs-5">🌿 Aucune culture trouvée.</p>
                <a href="{{ path('app_culture_new') }}" class="btn btn-success mt-2">Ajouter la première culture</a>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for culture in cultures %}
                <div class="col">
                    <div class="card h-100 shadow border-0" style="border-radius:15px;">
                        <div class="card-header text-white text-center py-3"
                             style="background: linear-gradient(to right,#4a7c3a,#66bb6a); border-radius:15px 15px 0 0;">
                            <h5 class="mb-0">🌿 {{ culture.nom }}</h5>
                        </div>
                        <div class="card-body px-4 py-3">
                            <p class="mb-2">
                                <span class="fw-bold" style="color:#4a7c3a;">📂 Type :</span>
                                <span class="badge ms-1" style="background-color:#66bb6a;">{{ culture.type }}</span>
                            </p>
                            <p class="mb-2">
                                <span class="fw-bold" style="color:#4a7c3a;">📐 Superficie :</span>
                                {{ culture.superficie }} ha
                            </p>
                            <p class="mb-2">
                                <span class="fw-bold" style="color:#4a7c3a;">📍 Localisation :</span>
                                {{ culture.localisation }}
                            </p>
                        </div>
                        <div class="card-footer bg-white border-0 px-4 pb-4">
                            <div class="d-flex gap-2">
                                <a href="{{ path('app_culture_show', {'id': culture.idCulture}) }}"
                                   class="btn btn-sm btn-outline-info flex-grow-1">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_culture_edit', {'id': culture.idCulture}) }}"
                                   class="btn btn-sm btn-outline-warning flex-grow-1">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('app_culture_delete', {'id': culture.idCulture}) }}"
                                      onsubmit="return confirm('Supprimer cette culture ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.idCulture) }}">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            {# ── PAGINATION KnpPaginator ── #}
            <div class="mt-5 p-4 border-top">
                <div class="row align-items-center g-3">
                    <div class="col-md-6">
                        {% set firstItem = (cultures.getCurrentPageNumber() - 1) * cultures.getItemNumberPerPage() + 1 %}

                        {# ✅ CORRECTION : remplacement de |min (filtre inexistant en Twig) #}
                        {% set calculatedLast = cultures.getCurrentPageNumber() * cultures.getItemNumberPerPage() %}
                        {% if calculatedLast > cultures.getTotalItemCount() %}
                            {% set lastItem = cultures.getTotalItemCount() %}
                        {% else %}
                            {% set lastItem = calculatedLast %}
                        {% endif %}

                        <p class="text-muted mb-0">
                            📊 Affichage de
                            <strong>{{ firstItem }}</strong> à
                            <strong>{{ lastItem }}</strong>
                            sur <strong>{{ cultures.getTotalItemCount() }}</strong> cultures
                            (Page <strong>{{ cultures.getCurrentPageNumber() }}</strong>/{{ cultures.getPageCount() }})
                        </p>
                    </div>
                    <div class="col-md-6 text-center">
                        {{ knp_pagination_render(cultures) }}
                    </div>
                </div>
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}

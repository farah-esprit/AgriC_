{% extends 'base.html.twig' %}

{% block title %}Inscription - AgriConnect{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="card shadow border-0" style="border-radius:15px;">
                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(135deg,#4a7c3a,#66bb6a); border-radius:15px 15px 0 0;">
                        <h4 class="mb-0 fw-bold">📝 Inscription - AgriConnect</h4>
                        <small class="opacity-75">Créez votre compte en 2 étapes</small>
                    </div>

                    <div class="card-body p-5">

                        {# ── BARRE DE PROGRESSION ── #}
                        <div class="d-flex align-items-center mb-4 gap-2" id="progress-bar">
                            <div class="step-indicator active" id="dot1">1</div>
                            <div class="step-line flex-grow-1" id="line1"></div>
                            <div class="step-indicator" id="dot2">2</div>
                        </div>

                        {{ form_start(form, {'attr': {'id': 'signup-form', 'novalidate': 'novalidate'}}) }}

                        {# ══════════════ ÉTAPE 1 ══════════════ #}
                        <div id="step1">

                            <div class="mb-3">
                                {{ form_label(form.nom, 'Nom', {'label_attr': {'class':'form-label fw-semibold'}}) }}
                                {{ form_widget(form.nom) }}
                                {{ form_errors(form.nom) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.email, 'Email', {'label_attr': {'class':'form-label fw-semibold'}}) }}
                                {{ form_widget(form.email) }}
                                {{ form_errors(form.email) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.role, 'Rôle', {'label_attr': {'class':'form-label fw-semibold'}}) }}
                                {{ form_widget(form.role) }}
                                {{ form_errors(form.role) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.plainPassword.first, 'Mot de passe', {'label_attr': {'class':'form-label fw-semibold'}}) }}
                                {{ form_widget(form.plainPassword.first) }}
                                {{ form_errors(form.plainPassword.first) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.plainPassword.second, 'Confirmer le mot de passe', {'label_attr': {'class':'form-label fw-semibold'}}) }}
                                {{ form_widget(form.plainPassword.second) }}
                                {{ form_errors(form.plainPassword.second) }}
                            </div>

                            <button type="button" class="btn btn-success w-100"
                                    style="background:linear-gradient(135deg,#4a7c3a,#66bb6a);border:none;"
                                    onclick="goToStep2()">
                                Suivant →
                            </button>
                        </div>

                        {# ══════════════ ÉTAPE 2 ══════════════ #}
                        <div id="step2" style="display:none;">

                            <div class="alert alert-success py-2 text-center mb-3" style="font-size:.875rem;">
                                📱 Numéro de téléphone
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.telephone, 'Téléphone', {'label_attr': {'class':'form-label fw-semibold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text fw-bold">+216</span>
                                    {{ form_widget(form.telephone, {'attr': {
                                        'class': 'form-control',
                                        'placeholder': '12345678',
                                        'maxlength': '8'
                                    }}) }}
                                </div>
                                <div id="phone-errors" class="text-danger mt-1 fw-bold small">
                                    {{ form_errors(form.telephone) }}
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <button type="button" class="btn btn-outline-secondary w-50"
                                        onclick="goToStep1()">
                                    ← Retour
                                </button>
                                {{ form_widget(form.submit, {'attr': {
                                    'class': 'btn btn-success w-50',
                                    'style': 'background:linear-gradient(135deg,#4a7c3a,#66bb6a);border:none;',
                                    'id': 'submit-btn'
                                }}) }}
                            </div>
                        </div>

                        {{ form_end(form) }}

                        <hr class="my-4">
                        <p class="text-center text-muted small mb-2">
                            Déjà un compte ?
                            <a href="{{ path('app_signin') }}" class="fw-bold text-success text-decoration-none">Se connecter</a>
                        </p>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ══════════════ STYLES ══════════════ #}
<style>
.step-indicator {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 600; font-size: .875rem;
    border: 2px solid #dee2e6;
    color: #6c757d;
    background: #fff;
    transition: all .3s;
    flex-shrink: 0;
}
.step-indicator.active  { border-color: #4a7c3a; color: #4a7c3a; }
.step-indicator.done    { border-color: #4a7c3a; background: #4a7c3a; color: #fff; }
.step-line {
    height: 2px;
    background: #dee2e6;
    transition: background .3s;
}
.step-line.done { background: #66bb6a; }
</style>

{# ══════════════ JAVASCRIPT ══════════════ #}
<script>
document.addEventListener("DOMContentLoaded", function() {
    // Si la page recharge et qu'il y a une erreur sur le téléphone, on rouvre directement l'étape 2 !
    const phoneErrors = document.getElementById('phone-errors');
    if (phoneErrors && phoneErrors.textContent.trim().length > 0) {
        document.getElementById('step1').style.display = 'none';
        document.getElementById('step2').style.display = 'block';

        const dot1 = document.getElementById('dot1');
        dot1.classList.remove('active');
        dot1.classList.add('done');
        dot1.textContent = '✓';
        document.getElementById('line1').classList.add('done');
        document.getElementById('dot2').classList.add('active');
    }
});

// ── Navigation entre étapes ──────────────────────────────────────
function goToStep2() {
    const step1Fields = ['registration_nom', 'registration_email',
                         'registration_plainPassword_first', 'registration_plainPassword_second'];
    let valid = true;

    step1Fields.forEach(id => {
        const el = document.getElementById(id);
        if (el && !el.value.trim()) { el.classList.add('is-invalid'); valid = false; }
        else if (el) el.classList.remove('is-invalid');
    });

    if (!valid) return;

    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';

    const dot1 = document.getElementById('dot1');
    dot1.classList.remove('active');
    dot1.classList.add('done');
    dot1.textContent = '✓';
    document.getElementById('line1').classList.add('done');
    document.getElementById('dot2').classList.add('active');

    attachStep2Events();
}

function goToStep1() {
    document.getElementById('step2').style.display = 'none';
    document.getElementById('step1').style.display = 'block';

    const dot1 = document.getElementById('dot1');
    dot1.classList.remove('done');
    dot1.classList.add('active');
    dot1.textContent = '1';
    document.getElementById('line1').classList.remove('done');
    document.getElementById('dot2').classList.remove('active');
}

// ── Attacher les événements de l'étape 2 ────────────────────────
function attachStep2Events() {
    // Plus de vérification SMS, le bouton soumet directement le formulaire
}

// ── Envoi du code SMS ────────────────────────────────────────────
function sendSmsCode() {
    const phoneEl = document.getElementById('registration_telephone');
    if (!phoneEl) { alert('Champ téléphone introuvable.'); return; }

    const phone = phoneEl.value.trim();

    if (!/^[0-9]{8}$/.test(phone)) {
        alert('Veuillez entrer un numéro valide (8 chiffres).');
        return;
    }

    const btn = document.getElementById('send-sms-btn');
    btn.disabled = true;
    btn.textContent = '⏳ Envoi en cours...';

    fetch('/api/send-sms', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: '+216' + phone })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showCodeBlock(phone);
            startResendTimer(btn);
        } else {
            alert('Erreur : ' + data.message);
            btn.disabled = false;
            btn.textContent = '📨 Envoyer le code SMS';
        }
    })
    .catch(() => {
        alert('Erreur réseau. Réessayez.');
        btn.disabled = false;
        btn.textContent = '📨 Envoyer le code SMS';
    });
}

// ── Vérification du code avant soumission ────────────────────────
function verifySmsCode(event) {
    event.preventDefault();

    const phone = document.getElementById('registration_telephone').value.trim();
    const code  = document.getElementById('sms-code-input').value.trim();

    fetch('/api/verify-sms', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: '+216' + phone, code: code })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            document.getElementById('signup-form').submit();
        } else {
            alert('❌ ' + data.message);
        }
    })
    .catch(() => {
        alert('Erreur réseau. Réessayez.');
    });
}

function showCodeBlock(phone) {
    document.getElementById('sms-code-block').style.display = 'block';
    document.getElementById('phone-display').textContent = phone;
}

function startResendTimer(btn) {
    let seconds = 60;
    const interval = setInterval(() => {
        btn.textContent = '🔄 Renvoyer dans ' + seconds + 's';
        seconds--;
        if (seconds < 0) {
            clearInterval(interval);
            btn.disabled = false;
            btn.textContent = '📨 Envoyer le code SMS';
        }
    }, 1000);
}
</script>
{% endblock %}
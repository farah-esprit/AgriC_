{% extends 'agriculteur.html.twig' %}

{% block title %}Calendrier Agricole IA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <style>
        .fc-event {
            cursor: pointer;
            border-radius: 6px;
            padding: 2px 5px;
            border: none;
            transition: transform 0.2s;
        }
        .fc-event:hover {
            transform: scale(1.02);
            filter: brightness(0.9);
        }
        
        /* Style spécial pour les suggestions IA */
        .ai-suggestion-event {
            border: 2px dashed #333 !important;
            opacity: 0.8;
        }
        
        .legend-item {
            display: inline-flex;
            align-items: center;
            margin-right: 15px;
            font-size: 0.9rem;
        }
        .legend-color {
            width: 15px;
            height: 15px;
            border-radius: 3px;
            margin-right: 5px;
        }
    </style>
{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">📅 Calendrier Agricole</h2>
                <p class="text-muted">Planifiez vos plantations, irrigations et récoltes avec l'aide de l'IA.</p>
            </div>
            <div class="bg-white p-3 shadow-sm rounded-3">
                <div class="legend-item"><div class="legend-color" style="background:#4caf50;"></div> Plantation</div>
                <div class="legend-item"><div class="legend-color" style="background:#2196f3;"></div> Irrigation</div>
                <div class="legend-item"><div class="legend-color" style="background:#ffc107;"></div> Récolte</div>
                <div class="legend-item"><div class="legend-color" style="background:#fff; border: 2px dashed #333;"></div> Suggestion IA</div>
            </div>
        </div>

        <div class="card shadow border-0" style="border-radius: 20px; overflow: hidden;">
            <div class="card-body p-4">
                <div id="calendar"></div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/fr.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },
                events: '/fc-load-events', // Route par défaut du CalendarBundle
                editable: true,
                eventClick: function(info) {
                    if (info.event.url) {
                        window.location.href = info.event.url;
                        info.jsEvent.preventDefault();
                    }
                }
            });
            calendar.render();
        });
    </script>
{% endblock %}

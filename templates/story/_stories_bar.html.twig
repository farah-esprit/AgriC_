<style>
    .stories-container {
        display: flex;
        gap: 15px;
        overflow-x: auto;
        padding: 15px 5px;
        margin-bottom: 20px;
        scrollbar-width: thin;
    }
    
    .stories-container::-webkit-scrollbar {
        height: 6px;
    }
    
    .stories-container::-webkit-scrollbar-thumb {
        background-color: rgba(0,0,0,0.2);
        border-radius: 4px;
    }

    .story-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        min-width: 70px;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

    .story-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background-color: #f0f0f0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.5rem;
        position: relative;
    }

    .story-circle.active {
        box-shadow: 0 0 0 2px white, 0 0 0 4px #28a745;
        background: linear-gradient(white, white) padding-box, linear-gradient(45deg, #28a745, #20c997) border-box;
        border: 2px solid transparent;
        transition: transform 0.2s ease;
    }
    
    .story-circle.active:hover {
        transform: scale(1.05);
    }
    
    .story-circle.add-story {
        border: 2px dashed #ccc;
        background-color: white;
    }

    .story-add-icon {
        position: absolute;
        bottom: 0;
        right: 0;
        background: var(--accent-color, #28a745);
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 0.8rem;
        border: 2px solid white;
    }

    .story-username {
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 70px;
    }
</style>

<div class="card shadow-sm mb-4" style="border: none; border-radius: 12px; overflow: hidden;">
    <div class="card-body p-3">
        <h6 class="text-muted mb-3 mx-2" style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-camera-reels me-2"></i>Stories Récentes</h6>
        <div class="stories-container" style="padding: 5px; margin-bottom: 0;">
        
        <!-- Add Story Button -->
        {% if app.user %}
        <div class="story-item text-decoration-none" onclick="document.getElementById('storyInput').click()">
            <div class="story-circle add-story">
                {% if app.user and app.user.profile and app.user.profile.image %}
                    <img src="{{ asset('uploads/profils/' ~ app.user.profile.image) }}" alt="Avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                {% else %}
                    <span style="font-size: 1.8rem; line-height: 1; color: #aaa;">👤</span>
                {% endif %}
                <div class="story-add-icon"><i class="bi bi-plus" style="font-size: 1rem; font-weight: bold;"></i></div>
            </div>
            <span class="story-username text-muted mt-1">Votre story</span>
            
            <!-- Hidden form for uploading story -->
            <form id="storyForm" action="{{ path('app_story_add') }}" method="POST" enctype="multipart/form-data" style="display: none;">
                <input type="file" id="storyInput" name="story_media" accept="image/*,video/*" onchange="document.getElementById('storyForm').submit()">
            </form>
        </div>
        {% endif %}

        <!-- Active Stories -->
        {% for userId, storyUser in activeStoriesUsers %}
        <a href="{{ path('app_story_view', {'id': userId}) }}" class="story-item text-decoration-none">
            <div class="story-circle active">
                {% if storyUser.profile and storyUser.profile.image %}
                    <img src="{{ asset('uploads/profils/' ~ storyUser.profile.image) }}" alt="Avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                {% else %}
                    <span style="font-size: 1.8rem; line-height: 1;">👤</span>
                {% endif %}
            </div>
            <span class="story-username text-muted mt-1">{{ storyUser.nom }}</span>
        </a>
        {% endfor %}
        
    </div>
</div>

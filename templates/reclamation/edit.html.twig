{% extends 'agriculteur.html.twig' %}

{% block title %}Modifier la Réclamation - AgriConnect{% endblock %}

{% block body %}
<div class="premium-header">
    <div class="container text-center">
        <h1 class="premium-title">Modifier la Réclamation</h1>
        <p class="premium-subtitle">Mettez à jour les informations de votre demande d'assistance.</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-premium-card shadow-lg border-0">
                <div class="mb-4 pb-3 border-bottom d-flex align-items-center gap-3">
                    <div class="bg-soft-agri p-3 rounded-circle" style="background: #e8f5e9;">
                        <i class="bi bi-pencil-square fs-3 text-agri"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Mise à jour de la demande</h4>
                        <p class="text-muted small mb-0">Modifier les champs ci-dessous.</p>
                    </div>
                </div>

                {{ include('reclamation/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

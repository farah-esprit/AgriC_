{% extends app.session.get('user_role') == 'FOURNISSEUR' ? 'fournisseur.html.twig' : (app.session.get('user_role') == 'AGRICULTEUR' ? 'agriculteur.html.twig' : 'base.html.twig') %}


{% block title %}Ajouter un Produit{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .input-group-text {
        background: linear-gradient(to bottom, #4a7c3a, #66bb6a);
        color: white;
        border: none;
    }
    .form-control:focus, .form-select:focus {
        border-color: #66bb6a;
        box-shadow: 0 0 0 0.2rem rgba(102, 187, 106, 0.25);
    }
    .form-check-input:checked {
        background-color: #4a7c3a;
        border-color: #4a7c3a;
    }
    .section-divider {
        border-top: 2px dashed #e0e0e0;
        margin: 20px 0;
    }
    .promo-section {
        background: #fff8f0;
        border: 1px dashed #ff9800;
        border-radius: 10px;
        padding: 15px;
    }
</style>
{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow border-0" style="border-radius: 15px;">
                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(to right, #4a7c3a, #66bb6a); border-radius: 15px 15px 0 0;">
                        <h3>🌿 Ajouter un Produit</h3>
                        <small class="opacity-75">Remplissez les informations du produit</small>
                    </div>
                    <div class="card-body p-5">



                        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tag-fill"></i></span>
                                {{ form_widget(form.nom, {'attr': {'class': 'form-control' ~ (form.nom.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'Ex: Engrais Bio'}}) }}
                            </div>
                            {{ form_errors(form.nom) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                {{ form_widget(form.description, {'attr': {'class': 'form-control' ~ (form.description.vars.errors|length > 0 ? ' is-invalid' : ''), 'rows': 3, 'placeholder': 'Décrivez le produit...'}}) }}
                            </div>
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.prix, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-cash-coin"></i></span>
                                    {{ form_widget(form.prix, {'attr': {'class': 'form-control' ~ (form.prix.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'Ex: 15.00'}}) }}
                                </div>
                                {{ form_errors(form.prix) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.categorie, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-grid-fill"></i></span>
                                    {{ form_widget(form.categorie, {'attr': {'class': 'form-select' ~ (form.categorie.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                                </div>
                                {{ form_errors(form.categorie) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.image, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-image-fill"></i></span>
                                {{ form_widget(form.image, {'attr': {'class': 'form-control' ~ (form.image.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            </div>
                            {{ form_errors(form.image) }}
                        </div>

                        <div class="section-divider"></div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.actif, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                                {{ form_label(form.actif, null, {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                                <small class="text-muted d-block">Activer pour rendre ce produit visible à la vente</small>
                            </div>
                        </div>

                        <div class="promo-section mb-3">
                            <div class="form-check form-switch mb-2">
                                {{ form_widget(form.promo, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                                {{ form_label(form.promo, null, {'label_attr': {'class': 'form-check-label fw-bold text-danger'}}) }}
                            </div>

                            <div id="tauxPromoField" style="display: {{ form.promo.vars.data ? 'block' : 'none' }};">
                                {{ form_label(form.tauxPromo, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-percent"></i></span>
                                    {{ form_widget(form.tauxPromo, {'attr': {'class': 'form-control' ~ (form.tauxPromo.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'Ex: 10'}}) }}
                                    <span class="input-group-text">%</span>
                                </div>
                                {{ form_errors(form.tauxPromo) }}
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success flex-grow-1 py-2">
                                <i class="bi bi-check-circle"></i> Ajouter le produit
                            </button>
                            <a href="{{ path('app_produit_index') }}" class="btn btn-outline-secondary py-2">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const promoCheckbox = document.querySelector('input[name="produit[promo]"]');
        const tauxPromoField = document.getElementById("tauxPromoField");

        function toggleTauxPromo() {
            tauxPromoField.style.display = promoCheckbox.checked ? "block" : "none";
        }

        toggleTauxPromo();
        promoCheckbox.addEventListener("change", toggleTauxPromo);
    });
</script>
{% endblock %}
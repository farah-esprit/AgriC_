{% extends 'base.html.twig' %}

{% block title %}Connexion - AgriConnect{% endblock %}

{% block body %}
<section style="padding: 120px 0 60px;">
    <div class="container">

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show text-center fw-bold">
                {{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show text-center fw-bold">
                {{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="card shadow border-0" style="border-radius:15px;">
                    <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg,#4a7c3a,#66bb6a); border-radius:15px 15px 0 0;">
                        <h4 class="mb-0 fw-bold">AgriConnect</h4>
                        <small class="opacity-75">Connectez-vous à votre espace</small>
                    </div>

                    <div class="card-body p-5">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                            <div class="text-danger small mt-1">{{ form_errors(form.email) }}</div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                {{ form_label(form.password, 'Mot de passe', {'label_attr': {'class': 'form-label fw-semibold mb-0'}}) }}
                                <a href="{{ path('app_forgot_password_request') }}" class="small text-success text-decoration-none fw-bold">Mot de passe oublié ?</a>
                            </div>
                            {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                            <div class="text-danger small mt-1">{{ form_errors(form.password) }}</div>
                        </div>

                        {{ form_widget(form.submit, {'attr': {'class': 'btn btn-success w-100', 'style':'background:linear-gradient(135deg,#4a7c3a,#66bb6a);border:none;'}}) }}

                        {{ form_end(form) }}

                        <div class="text-center my-3">
                            <span class="text-muted small fw-bold">OU</span>
                        </div>
                        
                        <a href="{{ path('connect_google_start') }}" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2 fw-semibold" style="border-radius:8px; padding: 10px;">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google Logo" style="width:20px;height:20px;">
                            Continuer avec Google
                        </a>

                        <a href="{{ path('face_login_page') }}" class="btn w-100 d-flex align-items-center justify-content-center gap-2 fw-semibold mt-2"
                           style="border-radius:8px; padding:10px; background:linear-gradient(135deg,#7BA00E,#5c7a0b); color:#fff; border:none; box-shadow: 0 4px 12px rgba(123,160,14,0.25); transition: all 0.3s ease;"
                           onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(123,160,14,0.35)';"
                           onmouseout="this.style.transform=''; this.style.boxShadow='0 4px 12px rgba(123,160,14,0.25)';">
                            <i class="fas fa-face-smile" style="font-size:1.2rem;"></i>
                            Se connecter par visage
                        </a>

                        <hr class="my-4">

                        <p class="text-center text-muted small mb-0">
                            Pas encore de compte ?
                            <a href="{{ path('app_signup') }}" class="fw-bold text-success text-decoration-none">S'inscrire</a>
                        </p>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}
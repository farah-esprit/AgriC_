{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de bord - Admin{% endblock %}

{% block admin_content %}

<style>
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }
    .dash-title {
        font-family: 'Outfit', sans-serif;
        font-size: 2.2rem;
        font-weight: 700;
        color: #111;
        margin: 0;
        letter-spacing: -0.03em;
    }
    .dash-subtitle {
        color: #64748b;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
    }
    .badge-status {
        background: #ecfdf5;
        color: #059669;
        padding: 0.5rem 1rem;
        border-radius: 30px;
        font-weight: 600;
        border: 1px solid #10b981;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    /* Premium KPI Cards */
    .kpi-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
        overflow: hidden;
        height: 100%;
    }
    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    }
    .kpi-card::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 150px;
        height: 150px;
        background: linear-gradient(135deg, rgba(123, 160, 14, 0.1), transparent);
        border-radius: 50%;
        transform: translate(30%, -30%);
    }
    .icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 1rem;
    }
    .kpi-label {
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 600;
    }
    .kpi-value {
        font-family: 'Outfit', sans-serif;
        font-size: 2.5rem;
        font-weight: 700;
        color: #111;
        line-height: 1.2;
    }
    
    /* Charts & Action Cards */
    .content-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        height: 100%;
    }
    .card-heading {
        font-family: 'Outfit', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: #111;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .card-heading i { color: #7BA00E; }
    
    .action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 1rem;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        margin-bottom: 1rem;
    }
    .btn-manage {
        background: #f8fafc;
        color: #0f172a;
        border: 1px solid #e2e8f0;
    }
    .btn-manage:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #000;
    }
    .btn-profile {
        background: #7BA00E;
        color: #fff;
    }
    .btn-profile:hover {
        background: #5c7a0b;
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(123, 160, 14, 0.3);
    }
    
    /* Info List */
    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .info-list li {
        padding: 1rem 0;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #334155;
        font-weight: 500;
    }
    .info-list li:last-child { border-bottom: none; }
    .info-list i { color: #94a3b8; }
</style>

<!-- HEADER -->
<div class="dash-header">
    <div>
        <h2 class="dash-title">Tableau de bord</h2>
        <div class="dash-subtitle">Bienvenue, {{ app.session.get('admin_prenom') }} {{ app.session.get('admin_nom') }}</div>
    </div>
    <div class="badge-status">
        <i class="fas fa-circle" style="font-size: 0.5rem; animation: pulse 2s infinite;"></i> En ligne
    </div>
</div>

<!-- STATS -->
<div class="row g-4 mb-4">
    <!-- USERS -->
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="icon-wrapper" style="background: rgba(15, 23, 42, 0.05); color: #0f172a;">
                <i class="fas fa-users"></i>
            </div>
            <div class="kpi-label">Total utilisateurs</div>
            <div class="kpi-value">{{ total_users }}</div>
        </div>
    </div>

    <!-- ACTIVE -->
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="icon-wrapper" style="background: rgba(123, 160, 14, 0.1); color: #7BA00E;">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="kpi-label">Comptes actifs</div>
            <div class="kpi-value" style="color: #5c7a0b;">{{ active_users }}</div>
        </div>
    </div>

    <!-- BLOCKED -->
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="icon-wrapper" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="fas fa-user-lock"></i>
            </div>
            <div class="kpi-label">Comptes bloqués</div>
            <div class="kpi-value" style="color: #b91c1c;">{{ blocked_users }}</div>
        </div>
    </div>
</div>

<!-- GRAPHS -->
<div class="row g-4 mb-4">
    <!-- EVOLUTION CHART -->
    <div class="col-lg-8">
        <div class="content-card">
            <h5 class="card-heading">
                <i class="fas fa-chart-area"></i> Évolution des Utilisateurs
            </h5>
            <div style="height: 300px; width: 100%;">
                <canvas id="userGrowthChart"></canvas>
            </div>
        </div>
    </div>

    <!-- RATIO CHART -->
    <div class="col-lg-4">
        <div class="content-card">
            <h5 class="card-heading">
                <i class="fas fa-chart-pie"></i> Répartition des Comptes
            </h5>
            <div style="height: 300px; width: 100%; display: flex; justify-content: center; align-items: center;">
                <canvas id="userRatioChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ACTIONS & INFOS -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="content-card">
            <h5 class="card-heading">
                <i class="fas fa-bolt"></i> Actions Rapides
            </h5>
            <div class="d-flex flex-column" style="margin-top: 1.5rem;">
                <a href="{{ path('admin_users') }}" class="action-btn btn-manage">
                    <i class="fas fa-users-cog"></i> Gérer les Utilisateurs Actifs
                </a>
                <a href="{{ path('admin_profile') }}" class="action-btn btn-profile">
                    <i class="fas fa-user-edit"></i> Modifier Mon Profil
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="content-card">
            <h5 class="card-heading">
                <i class="fas fa-info-circle"></i> Info Session
            </h5>
            <ul class="info-list">
                <li><i class="fas fa-envelope"></i> {{ app.session.get('admin_email') ?? 'admin@agriconnect.com' }}</li>
                <li><i class="fas fa-shield-alt"></i> Rôle : Administrateur Principal</li>
                <li><i class="fas fa-clock"></i> Date : {{ "now"|date("d/m/Y - H:i") }}</li>
            </ul>
        </div>
    </div>
</div>

<!-- CHART.JS SCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // --- 1. GROWTH LINE CHART ---
    const growthCtx = document.getElementById('userGrowthChart').getContext('2d');
    
    // Create elegant gradient for the line chart fill
    let gradientFill = growthCtx.createLinearGradient(0, 0, 0, 300);
    gradientFill.addColorStop(0, 'rgba(123, 160, 14, 0.4)');
    gradientFill.addColorStop(1, 'rgba(123, 160, 14, 0.0)');

    new Chart(growthCtx, {
        type: 'line',
        data: {
            labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin'],
            datasets: [{
                label: 'Nouveaux Utilisateurs',
                data: [5, 12, 10, 18, 25, 23],
                borderColor: '#7BA00E',
                backgroundColor: gradientFill,
                borderWidth: 3,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#7BA00E',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6,
                fill: true,
                tension: 0.4 // Smooth curves
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#111',
                    padding: 10,
                    titleFont: { family: 'Inter', size: 13 },
                    bodyFont: { family: 'Inter', size: 14, weight: 'bold' },
                    displayColors: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
                    ticks: { font: { family: 'Inter' }, color: '#94a3b8' }
                },
                x: {
                    grid: { display: false, drawBorder: false },
                    ticks: { font: { family: 'Inter' }, color: '#94a3b8' }
                }
            }
        }
    });

    // --- 2. RATIO DOUGHNUT CHART ---
    const ratioCtx = document.getElementById('userRatioChart').getContext('2d');
    const activeCount = {{ active_users|default(0) }};
    const blockedCount = {{ blocked_users|default(0) }};
    
    // Default data if metrics are empty to show the chart design anyway
    const finalActive = activeCount === 0 && blockedCount === 0 ? 1 : activeCount;
    const finalBlocked = activeCount === 0 && blockedCount === 0 ? 0 : blockedCount;

    new Chart(ratioCtx, {
        type: 'doughnut',
        data: {
            labels: ['Actifs', 'Bloqués'],
            datasets: [{
                data: [finalActive, finalBlocked],
                backgroundColor: ['#7BA00E', '#ef4444'],
                hoverBackgroundColor: ['#8fbb11', '#f87171'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '75%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        font: { family: 'Inter', size: 13, weight: '500' },
                        color: '#334155',
                        usePointStyle: true,
                        padding: 20
                    }
                },
                tooltip: {
                    backgroundColor: '#111',
                    bodyFont: { family: 'Inter', size: 14 },
                    callbacks: {
                        label: function(context) {
                            return ' ' + context.label + ' : ' + context.raw;
                        }
                    }
                }
            }
        }
    });

});
</script>

{% endblock %}